---
// src/components/Header.astro
import NavLogo from './NavLogo.astro';

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;
---

<nav class="nav-bar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <NavLogo />
    </a>
    <div class="nav-links">
      <a href="/#stream" class={currentPage === "streams" ? "active" : ""} data-pt="Transmissões" data-en="Streams">Transmissões</a>
      <a href="/terminal" class={currentPage === "terminal" ? "active" : ""} data-pt="Terminal" data-en="Terminal">Terminal</a>
      <a href="/vtubers" class={currentPage === "vtubers" ? "active" : ""} data-pt="VTubers" data-en="VTubers">VTubers</a>
      <a href="/dossier" class={currentPage === "dossier" ? "active" : ""} data-pt="Dossiê" data-en="Dossier">Dossiê</a>
      <a href="/about" class={currentPage === "about" ? "active" : ""} data-pt="Sobre" data-en="About">Sobre</a>
      <a href="/#signal" class={currentPage === "signal" ? "active" : ""} data-pt="Sinal" data-en="Signal">Sinal</a>
      <button id="lang-toggle" class="lang-btn">EN</button>
    </div>
  </div>
</nav>

<style>
  .nav-bar { 
    background: rgba(11, 12, 16, 0.95); 
    border-bottom: 1px solid rgba(230, 57, 70, 0.2); 
    position: sticky; 
    top: 0; 
    backdrop-filter: blur(10px); 
    z-index: 100; 
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-container { 
    width: 100%;
    max-width: 960px; 
    margin: 0 auto; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 1.5rem; 
  }
  
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }

  .nav-links a { 
    color: var(--text-secondary, #8D99AE); 
    text-decoration: none; 
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem; 
    font-weight: 600; 
    transition: color 0.2s ease;
  }

  .nav-links a:hover, .nav-links a.active { 
    color: var(--accent-crimson, #E63946); 
  }

  .lang-btn { 
    background: transparent; 
    border: 1px solid var(--accent-blue, #4CC9F0); 
    color: var(--accent-blue, #4CC9F0); 
    padding: 0.2rem 0.6rem; 
    border-radius: 4px; 
    cursor: pointer; 
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700; 
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .lang-btn:hover { 
    background: rgba(76, 201, 240, 0.15); 
    box-shadow: 0 0 8px rgba(76, 201, 240, 0.4); 
  }

  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
  }
</style>