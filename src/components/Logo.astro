---
// src/components/Logo.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`crest-wrapper ${className}`}>
  <img src="/logo.png" alt="Emblema Beyond Obvious" class="crest-image" />
</div>

<style>
  .crest-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .crest-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(230, 57, 70, 0.4));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .crest-wrapper:hover .crest-image {
    transform: scale(1.03);
    filter: drop-shadow(0 0 20px rgba(230, 57, 70, 0.7));
  }
</style>