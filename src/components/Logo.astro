---
// src/components/Logo.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`crest-wrapper ${className}`}>
  <img 
    src="/logo.png" 
    alt="Emblema Beyond Obvious" 
    class="crest-image"
    width="200"
    height="200"
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .crest-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .crest-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 0 12px rgba(230, 57, 70, 0.4));
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), filter 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .crest-wrapper:hover .crest-image {
    transform: scale(1.03);
    filter: drop-shadow(0 0 20px rgba(230, 57, 70, 0.7));
  }
</style>