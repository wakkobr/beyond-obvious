---
// src/components/I18nScript.astro
---

<script>
  const setupLanguageToggle = () => {
    const toggleBtn = document.getElementById('lang-toggle');
    let currentLang = localStorage.getItem('siteLang') || 'pt';

    const applyLanguage = () => {
      document.documentElement.lang = currentLang === 'pt' ? 'pt-BR' : 'en';

      if (toggleBtn) {
        toggleBtn.textContent = currentLang === 'pt' ? 'EN' : 'PT';
      }

      document.querySelectorAll<HTMLElement>('[data-pt][data-en]').forEach((el) => {
        const text = currentLang === 'pt' ? el.getAttribute('data-pt') : el.getAttribute('data-en');
        if (text) {
          el.innerHTML = text;
        }
      });

      // Dispara evento global para componentes reativos (ex: Grimório / Terminal)
      window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: currentLang } }));
    };

    // Aplica o idioma salvo assim que carregar
    applyLanguage();

    toggleBtn?.addEventListener('click', () => {
      currentLang = currentLang === 'pt' ? 'en' : 'pt';
      localStorage.setItem('siteLang', currentLang);
      applyLanguage();
    });
  };

  // Suporte a carregamento inicial e navegação SPA do Astro
  document.addEventListener('DOMContentLoaded', setupLanguageToggle);
  document.addEventListener('astro:page-load', setupLanguageToggle);
</script>