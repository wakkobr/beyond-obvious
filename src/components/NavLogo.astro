---
// src/components/NavLogo.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`nav-logo-hud ${className}`}>
  <div class="logo-text">
    <span class="text-beyond">BEYOND</span>
    <span class="text-obvious">OBVIOUS</span>
  </div>
  
  <div class="hud-subline">
    <span class="hud-marker-left"></span>
    <span 
      class="hud-status" 
      data-pt="SISTEMA // ARCANO.ATIVO" 
      data-en="SYSTEM // ARCANE.ACTIVE"
    >
      SISTEMA // ARCANO.ATIVO
    </span>
    <span class="hud-marker-right"></span>
  </div>
</div>

<style>
  .nav-logo-hud {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    user-select: none;
    text-decoration: none;
  }

  .logo-text {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: 2px;
    line-height: 1;
    display: flex;
    gap: 8px;
  }

  .text-beyond {
    color: var(--text-primary, #E0E1DD);
  }

  .text-obvious {
    color: var(--accent-crimson, #E63946);
    transition: text-shadow 0.2s ease;
  }

  .hud-subline {
    display: flex;
    align-items: center;
    width: 100%;
    margin-top: 5px;
    position: relative;
  }

  .hud-status {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.6rem;
    letter-spacing: 1.5px;
    color: var(--accent-blue, #4CC9F0);
    padding: 0 6px;
    white-space: nowrap;
    transition: text-shadow 0.2s ease;
  }

  .hud-marker-left {
    height: 2px;
    width: 16px;
    background-color: var(--accent-crimson, #E63946);
  }

  .hud-marker-right {
    height: 2px;
    flex-grow: 1;
    background: linear-gradient(90deg, rgba(76, 201, 240, 0.3), var(--accent-blue, #4CC9F0));
    transition: box-shadow 0.2s ease;
  }

  .nav-logo-hud:hover .text-obvious {
    text-shadow: 0 0 10px rgba(230, 57, 70, 0.6);
  }

  .nav-logo-hud:hover .hud-status {
    text-shadow: 0 0 8px rgba(76, 201, 240, 0.8);
  }
  
  .nav-logo-hud:hover .hud-marker-right {
    box-shadow: 0 0 8px var(--accent-blue, #4CC9F0);
  }
</style>