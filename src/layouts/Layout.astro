---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPage?: string;
  type?: string;
}

const {
  title = "BEYOND OBVIOUS // @w4kkomancer_",
  description = "Portal de convergência arcano-digital. RPG de mesa, análises de jogos, crônicas narrativas e hub de transmissão para operadores virtuais.",
  image = "/og-image.png",
  currentPage = "home",
  type = "website"
} = Astro.props;

const siteUrl = "https://www.beyond-obvious.net";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Título Principal & SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="w4kkomancer_" />
    <meta name="theme-color" content="#E63946" />

    <!-- Open Graph / Facebook / Discord / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="BEYOND OBVIOUS" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X / Bluesky Preview Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@w4kkomancer_" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Orbitron:wght@600;800;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header currentPage={currentPage} />
    <main class="container">
      <slot />
    </main>
    <Footer />

    <!-- Script de alternância de idioma (Global) -->
    <script>
      let currentLang: 'pt' | 'en' = 'pt';

      function updateLanguage(lang: 'pt' | 'en') {
        currentLang = lang;
        document.querySelectorAll<HTMLElement>('[data-pt][data-en]').forEach((el) => {
          const text = el.getAttribute(`data-${lang}`);
          if (text) el.innerText = text;
        });

        const langBtn = document.getElementById('lang-toggle');
        if (langBtn) {
          langBtn.innerText = lang === 'pt' ? 'EN' : 'PT';
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const langBtn = document.getElementById('lang-toggle');
        langBtn?.addEventListener('click', () => {
          updateLanguage(currentLang === 'pt' ? 'en' : 'pt');
        });
      });
    </script>
  </body>
</html>