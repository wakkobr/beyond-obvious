---
// src/pages/terminal/[slug].astro
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, type CategoryId } from '../../data/grimorio';

export async function getStaticPaths() {
  const posts = await getCollection('terminal');
  return posts.map((entry: CollectionEntry<'terminal'>) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, '') },
    props: { entry },
  }));
}

// Tipagem explícita da prop recebida
const { entry } = Astro.props as { entry: CollectionEntry<'terminal'> };
const { Content } = await render(entry);

const rawCat = String(entry.data.category || '').toLowerCase().trim() as CategoryId;
const categoryKey: CategoryId = CATEGORIES[rawCat] ? rawCat : 'tech';
const catInfo = CATEGORIES[categoryKey];

const categoryLabelsEn: Record<string, string> = {
  tech: "Tech & Systems",
  games: "Games",
  rpg: "Tabletop RPG",
  cinema: "Cinema & TV",
  books: "Books & Literature",
  meta: "Meta & Lore",
};
const labelEn = categoryLabelsEn[categoryKey] || catInfo.label;

const starDisplay = entry.data.rating ? '★'.repeat(parseInt(entry.data.rating, 10)) : '';

const dateObj = new Date(entry.data.publishDate);
const formattedDatePt = dateObj.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const formattedDateEn = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout
  title={`${entry.data.title} // TERMINAL - BEYOND OBVIOUS`}
  description={entry.data.summary || "Registro arquivado no Terminal Central do Além do Óbvio."}
  currentPage="terminal"
  type="article"
>
  <div class="back-nav">
    <a href="/terminal" class="back-link" data-pt="&larr; RETORNAR AO TERMINAL" data-en="&larr; RETURN TO TERMINAL">
      &larr; RETORNAR AO TERMINAL
    </a>
  </div>

  <article class="hud-card post-article">
    <div class="crest-corner top-left"></div>
    <div class="crest-corner top-right"></div>
    <div class="crest-corner bottom-left"></div>
    <div class="crest-corner bottom-right"></div>

    <header class="article-header">
      <div class="article-meta">
        <span class={`category-tag ${catInfo.badgeClass}`}>
          {catInfo.icon} <span data-pt={catInfo.label} data-en={labelEn}>{catInfo.label}</span>
        </span>
        {starDisplay && <span class="star-rating">{starDisplay}</span>}
        <span class="article-date">
          <code data-pt={`◈ ${formattedDatePt}`} data-en={`◈ ${formattedDateEn}`}>◈ {formattedDatePt}</code>
        </span>
      </div>
      <h1 class="article-title">{entry.data.title}</h1>
      {entry.data.summary && <p class="article-summary">{entry.data.summary}</p>}
    </header>

    <div class="markdown-body">
      <Content />
    </div>

    {entry.data.externalLink && (
      <div class="external-box">
        <a href={entry.data.externalLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline" data-pt="🌐 ACESSAR REGISTRO COMPLETO // WORLD ANVIL &rarr;" data-en="🌐 ACCESS FULL RECORD // WORLD ANVIL &rarr;">
          🌐 ACESSAR REGISTRO COMPLETO // WORLD ANVIL &rarr;
        </a>
      </div>
    )}
  </article>
</Layout>

<style>
  .back-nav {
    padding: 2rem 0 1.5rem;
  }

  .back-link {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--accent-blue);
    text-decoration: none;
    letter-spacing: 1px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-crimson);
  }

  .post-article {
    background: var(--bg-surface);
    border: 1px solid rgba(224, 225, 221, 0.12);
    border-radius: 6px;
    padding: 2.5rem;
  }

  .article-header {
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }

  .category-tag {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .star-rating {
    color: var(--accent-gold);
    letter-spacing: 2px;
  }

  .article-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-left: auto;
  }

  .article-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2rem;
    color: var(--text-primary);
    margin: 0 0 0.8rem;
    line-height: 1.2;
    letter-spacing: 1px;
  }

  .article-summary {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0;
    font-style: italic;
  }

  .markdown-body {
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .markdown-body :global(h2) {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.5rem;
    color: var(--accent-crimson);
    margin: 2rem 0 1rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 0.4rem;
  }

  .markdown-body :global(h3) {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.25rem;
    color: var(--accent-blue);
    margin: 1.5rem 0 0.8rem;
  }

  .markdown-body :global(p) {
    margin-bottom: 1.4rem;
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 1.4rem;
    padding-left: 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .markdown-body :global(blockquote) {
    border-left: 3px solid var(--accent-blue);
    background: rgba(11, 12, 16, 0.6);
    padding: 0.8rem 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .markdown-body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .markdown-body :global(pre) {
    background: #0B0C10;
    border: 1px solid rgba(224, 225, 221, 0.1);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .external-box {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(224, 225, 221, 0.1);
    text-align: center;
  }

  @media (max-width: 768px) {
    .post-article { padding: 1.5rem 1.2rem; }
    .article-title { font-size: 1.6rem; }
  }
</style>