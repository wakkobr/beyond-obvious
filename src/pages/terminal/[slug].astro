---
// src/pages/terminal/[slug].astro
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import I18nScript from '../../components/I18nScript.astro';

export async function getStaticPaths() {
  const posts = await getCollection('terminal');
  return posts.map((entry: CollectionEntry<'terminal'>) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'terminal'>;
}

const { entry } = Astro.props;

// Novo padrão do Astro para renderizar coleções Markdown
const { Content } = await render(entry);

const starDisplay = entry.data.rating ? '★'.repeat(parseInt(entry.data.rating, 10)) : '';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{entry.data.title} // TERMINAL - BEYOND OBVIOUS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
</head>
<body>

  <Header currentPage="terminal" />

  <main class="container">
    
    <div class="back-nav">
      <a href="/terminal" class="back-link" data-pt="&larr; RETORNAR AO TERMINAL" data-en="&larr; RETURN TO TERMINAL">
        &larr; RETORNAR AO TERMINAL
      </a>
    </div>

    <article class="hud-card post-article">
      <div class="crest-corner top-left"></div>
      <div class="crest-corner top-right"></div>
      <div class="crest-corner bottom-left"></div>
      <div class="crest-corner bottom-right"></div>

      <header class="article-header">
        <div class="article-meta">
          <span class={`category-tag cat-${String(entry.data.category || '').toLowerCase().trim()}`}>
            {String(entry.data.category || '').toUpperCase()}
          </span>
          {starDisplay && <span class="star-rating">{starDisplay}</span>}
          <span class="article-date">{new Date(entry.data.publishDate).toLocaleDateString('pt-BR')}</span>
        </div>
        <h1 class="article-title">{entry.data.title}</h1>
        {entry.data.summary && <p class="article-summary">{entry.data.summary}</p>}
      </header>

      {entry.data.coverImage && (
        <div class="cover-frame">
          <img src={entry.data.coverImage} alt={entry.data.title} class="cover-img" />
        </div>
      )}

      <div class="markdown-body">
        <Content />
      </div>

      {entry.data.externalLink && (
        <div class="external-box">
          <a href={entry.data.externalLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-blue" data-pt="🌐 ACESSAR REGISTRO COMPLETO // WORLD ANVIL &rarr;" data-en="🌐 ACCESS FULL RECORD // WORLD ANVIL &rarr;">
            🌐 ACESSAR REGISTRO COMPLETO // WORLD ANVIL &rarr;
          </a>
        </div>
      )}
    </article>

  </main>

  <Footer />

  <I18nScript />

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --accent-purple: #9D4EDD;
    --accent-pink: #F72585;
    --accent-gold: #F4A261;
    --accent-green: #2A9D8F;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.7;
  }

  .container { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; }

  .back-nav {
    padding: 2rem 0 1.5rem;
  }

  .back-link {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--accent-blue);
    text-decoration: none;
    letter-spacing: 1px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-crimson);
  }

  .post-article {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid rgba(224, 225, 221, 0.12);
    border-radius: 6px;
    padding: 2.5rem;
  }

  .crest-corner {
    position: absolute;
    width: 8px;
    height: 8px;
  }
  .crest-corner.top-left { top: -1px; left: -1px; border-top: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.top-right { top: -1px; right: -1px; border-top: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-left { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-right { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }

  .article-header {
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }

  .category-tag { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.85rem; letter-spacing: 1px; }
  .category-tag.cat-gaming { color: var(--accent-pink); }
  .category-tag.cat-ttrpg { color: var(--accent-purple); }
  .category-tag.cat-book { color: var(--accent-blue); }
  .category-tag.cat-cinema { color: var(--accent-gold); }
  .category-tag.cat-anime { color: var(--accent-green); }

  .star-rating { color: var(--accent-gold); letter-spacing: 2px; }

  .article-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-left: auto;
  }

  .article-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2rem;
    color: var(--text-primary);
    margin: 0 0 0.8rem;
    line-height: 1.2;
    letter-spacing: 1px;
  }

  .article-summary {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0;
    font-style: italic;
  }

  .cover-frame {
    width: 100%;
    max-height: 380px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid rgba(224, 225, 221, 0.1);
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ESTILOS DO MARKDOWN BODY */
  .markdown-body {
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  .markdown-body :global(h2) {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.5rem;
    color: var(--accent-crimson);
    margin: 2rem 0 1rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 0.4rem;
  }

  .markdown-body :global(h3) {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.25rem;
    color: var(--accent-blue);
    margin: 1.5rem 0 0.8rem;
  }

  .markdown-body :global(p) {
    margin-bottom: 1.4rem;
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 1.4rem;
    padding-left: 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .markdown-body :global(blockquote) {
    border-left: 3px solid var(--accent-blue);
    background: rgba(11, 12, 16, 0.6);
    padding: 0.8rem 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .markdown-body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .markdown-body :global(pre) {
    background: #0B0C10;
    border: 1px solid rgba(224, 225, 221, 0.1);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .external-box {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(224, 225, 221, 0.1);
    text-align: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }

  .btn-outline-blue {
    background: transparent;
    border: 1px solid var(--accent-blue);
    color: var(--accent-blue);
  }

  .btn-outline-blue:hover {
    background: rgba(76, 201, 240, 0.2);
    box-shadow: 0 0 10px rgba(76, 201, 240, 0.4);
    color: #fff;
  }

  @media (max-width: 768px) {
    .post-article { padding: 1.5rem 1.2rem; }
    .article-title { font-size: 1.6rem; }
  }
</style>