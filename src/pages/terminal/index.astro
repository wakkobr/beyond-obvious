---
// src/pages/terminal/index.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

type TerminalPost = CollectionEntry<'terminal'>;

interface ProcessedPost extends TerminalPost {
  slug: string;
  stars: string;
  formattedDate: string;
}

const posts = await getCollection('terminal');

const sortedPosts: ProcessedPost[] = posts
  .sort((a: TerminalPost, b: TerminalPost) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post: TerminalPost): ProcessedPost => ({
    ...post,
    slug: post.id.replace(/\.[^/.]+$/, ''),
    stars: post.data.rating ? '★'.repeat(parseInt(post.data.rating, 10)) : '',
    formattedDate: new Date(post.data.publishDate).toLocaleDateString('pt-BR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
  }));

const rawCategories: string[] = posts.map((p: TerminalPost) => String(p.data.category || '').toUpperCase().trim());
const uniqueCategories: string[] = Array.from(new Set<string>(rawCategories.filter(Boolean)));
const categories: string[] = ['TODOS', ...uniqueCategories];
---

<Layout title="TERMINAL DE MÍDIA // BEYOND OBVIOUS" currentPage="terminal">
  <!-- HEADER DO TERMINAL -->
  <header class="terminal-header">
    <div class="status-badge" data-pt="◈ ARQUIVO CENTRAL // REGISTROS DE MÍDIA & ENSAIOS" data-en="◈ CENTRAL ARCHIVE // MEDIA LOGS & ESSAYS">
      ◈ ARQUIVO CENTRAL // REGISTROS DE MÍDIA & ENSAIOS
    </div>
    <h1 class="terminal-title">TERMINAL DE MÍDIA</h1>
    <p class="terminal-sub" data-pt="Análises, registros de sessões, ensaios narrativos e desconstrução de mecânicas de ficção e jogos." data-en="Analyses, session logs, narrative essays, and mechanics breakdowns of fiction and games.">
      Análises, registros de sessões, ensaios narrativos e desconstrução de mecânicas de ficção e jogos.
    </p>
    
    <!-- FILTROS POR CATEGORIA DINÂMICOS -->
    <div class="filter-bar">
      {categories.map((cat: string, idx: number) => (
        <button 
          type="button" 
          class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
          data-target={cat.toLowerCase().trim()}
          data-pt={cat === 'TODOS' ? '[ TODOS ]' : cat}
          data-en={cat === 'TODOS' ? '[ ALL ]' : cat}
        >
          {cat === 'TODOS' ? '[ TODOS ]' : cat}
        </button>
      ))}
    </div>
  </header>

  <!-- LISTAGEM DE POSTS -->
  <section class="posts-section">
    <div class="posts-grid" id="posts-container">
      {sortedPosts.length > 0 ? (
        sortedPosts.map((post: ProcessedPost) => (
          <article 
            class="hud-card post-card" 
            data-cat={String(post.data.category || '').toLowerCase().trim()}
          >
            <div class="card-meta">
              <span class={`category-tag cat-${String(post.data.category || '').toLowerCase().trim()}`}>
                {String(post.data.category || '').toUpperCase()}
              </span>
              {post.stars && (
                <span class="star-rating">{post.stars}</span>
              )}
            </div>
            
            <h2 class="card-title">{post.data.title}</h2>
            
            <div class="post-date">
              <code>◈ {post.formattedDate}</code>
            </div>

            <p class="card-desc">
              {post.data.summary}
            </p>
            
            <div class="card-actions-terminal mt-3">
              <a href={`/terminal/${post.slug}`} class="btn-link" data-pt="Acessar Registro Completo &rarr;" data-en="Access Full Log &rarr;">
                Acessar Registro Completo &rarr;
              </a>
            </div>
          </article>
        ))
      ) : (
        <div class="hud-card empty-card">
          <p class="card-desc" data-pt="Nenhum registro encontrado no terminal." data-en="No records found in terminal.">Nenhum registro encontrado no terminal.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<!-- SCRIPT DE FILTRAGEM -->
<script is:inline>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.post-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const target = (btn.getAttribute('data-target') || '').toLowerCase().trim();

      cards.forEach((card) => {
        const itemCat = (card.getAttribute('data-cat') || '').toLowerCase().trim();
        if (target === 'todos' || itemCat === target) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });
    });
  });
</script>

<style>
  .terminal-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    margin-bottom: 2.5rem;
  }

  .terminal-title { 
    font-family: 'Orbitron', sans-serif; 
    font-size: 2.6rem; 
    margin: 0; 
    color: var(--text-primary); 
    letter-spacing: 2px; 
  }

  .terminal-sub { 
    color: var(--text-secondary); 
    font-size: 1.1rem; 
    margin: 0.6rem 0 1.5rem; 
  }

  .filter-bar {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .filter-btn {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(224, 225, 221, 0.15);
    color: var(--text-secondary);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent-crimson);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-crimson);
    border-color: var(--accent-crimson);
    color: white;
    box-shadow: 0 0 10px rgba(230, 57, 70, 0.4);
  }

  .posts-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); 
    gap: 1.5rem; 
  }

  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-card.is-hidden {
    display: none !important;
  }

  .card-title { font-family: 'Rajdhani', sans-serif; font-size: 1.35rem; margin: 0.3rem 0 0.5rem; color: var(--text-primary); }
  .card-desc { color: var(--text-secondary); margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.5; }
  .card-meta { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.4rem; }
  
  .category-tag { font-weight: 700; font-family: 'Rajdhani', sans-serif; letter-spacing: 1px; }
  .cat-avian, .category-tag.cat-avian { color: #4CC9F0; }
  .cat-rpg, .category-tag.cat-rpg { color: #9D4EDD; }
  .cat-gaming, .category-tag.cat-gaming { color: #F72585; }
  .cat-narrativas, .category-tag.cat-narrativas { color: #F4A261; }
  .cat-nexus, .category-tag.cat-nexus { color: #2A9D8F; }
  .cat-book, .category-tag.cat-book { color: #4CC9F0; }
  .cat-cinema, .category-tag.cat-cinema { color: #F4A261; }
  .cat-anime, .category-tag.cat-anime { color: #2A9D8F; }

  .star-rating { color: #F4A261; letter-spacing: 2px; }

  .post-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
  }

  .card-actions-terminal { display: flex; justify-content: flex-end; margin-top: auto; }

  .empty-card {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1.5rem;
  }

  @media (max-width: 768px) {
    .terminal-title { font-size: 2rem; }
  }
</style>