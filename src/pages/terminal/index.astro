---
// src/pages/terminal/index.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import NavLogo from '../../components/NavLogo.astro';

type TerminalPost = CollectionEntry<'terminal'>;

interface ProcessedPost extends TerminalPost {
  slug: string;
  stars: string;
  formattedDate: string;
}

const posts = await getCollection('terminal');

const sortedPosts: ProcessedPost[] = posts
  .sort((a: TerminalPost, b: TerminalPost) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post: TerminalPost): ProcessedPost => ({
    ...post,
    slug: post.id.replace(/\.[^/.]+$/, ''),
    stars: '★'.repeat(parseInt(post.data.rating || '5', 10)),
    formattedDate: new Date(post.data.publishDate).toLocaleDateString('pt-BR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
  }));

const rawCategories: string[] = posts.map((p: TerminalPost) => String(p.data.category || '').toUpperCase().trim());
const uniqueCategories: string[] = Array.from(new Set<string>(rawCategories.filter(Boolean)));
const categories: string[] = ['TODOS', ...uniqueCategories];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>TERMINAL DE MÍDIA // BEYOND OBVIOUS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- NAVEGAÇÃO -->
  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="/">&larr; Hub Principal</a>
        <a href="/terminal" class="active">Terminal</a>
        <a href="/about">Sobre</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- HEADER DO TERMINAL -->
    <header class="terminal-header">
      <div class="status-badge">◈ ARQUIVO DE TRANSMISSÕES // LOGS & REVIEWS</div>
      <h1 class="terminal-title">TERMINAL DE MÍDIA</h1>
      <p class="terminal-sub">
        Análises, registros de sessões, ensaios narrativos e desconstrução de mecânicas de jogos.
      </p>
      
      <!-- FILTROS POR CATEGORIA -->
      <div class="filter-bar">
        {categories.map((cat: string, idx: number) => (
          <button 
            type="button" 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
            data-target={cat.toLowerCase().trim()}
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <!-- LISTAGEM DE POSTS -->
    <section class="posts-section">
      <div class="posts-grid" id="posts-container">
        {sortedPosts.length > 0 ? (
          sortedPosts.map((post: ProcessedPost) => (
            <article 
              class="hud-card post-card" 
              data-cat={String(post.data.category || '').toLowerCase().trim()}
            >
              <div class="card-meta">
                <span class={`category-tag cat-${String(post.data.category || '').toLowerCase().trim()}`}>
                  {String(post.data.category || '').toUpperCase()}
                </span>
                <span class="star-rating">
                  {post.stars}
                </span>
              </div>
              
              <h2 class="card-title">{post.data.title}</h2>
              
              <div class="post-date">
                <code>◈ {post.formattedDate}</code>
              </div>

              <p class="card-desc">
                {post.data.summary}
              </p>
              
              <div class="card-actions-terminal mt-3">
                <a href={`/terminal/${post.slug}`} class="btn-link">
                  Acessar Registro Completo &rarr;
                </a>
              </div>
            </article>
          ))
        ) : (
          <div class="hud-card empty-card">
            <p class="card-desc">Nenhum registro encontrado no terminal.</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @W4KKO_</p>
  </footer>

  <!-- SCRIPT DE FILTRAGEM SEM DEPENDÊNCIA EXTERNA -->
  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.post-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const target = (btn.getAttribute('data-target') || '').toLowerCase().trim();

        cards.forEach((card) => {
          const itemCat = (card.getAttribute('data-cat') || '').toLowerCase().trim();
          if (target === 'todos' || itemCat === target) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --accent-purple: #9D4EDD;
    --accent-pink: #F72585;
    --accent-gold: #F4A261;
    --accent-green: #2A9D8F;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
  
  .nav-bar { 
    background: rgba(11, 12, 16, 0.95); 
    border-bottom: 1px solid rgba(230, 57, 70, 0.2); 
    position: sticky; 
    top: 0; 
    backdrop-filter: blur(10px); 
    z-index: 100; 
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-container { 
    width: 100%;
    max-width: 960px; 
    margin: 0 auto; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 1.5rem; 
  }
  
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }
  .nav-links a { 
    color: var(--text-secondary); 
    text-decoration: none; 
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem; 
    font-weight: 600; 
    transition: color 0.2s ease;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--accent-crimson); }

  .terminal-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    margin-bottom: 2.5rem;
  }

  .status-badge { 
    display: inline-block; 
    font-size: 0.75rem; 
    color: var(--accent-blue); 
    border: 1px solid rgba(76,201,240,0.3); 
    padding: 0.3rem 0.8rem; 
    border-radius: 20px; 
    margin-bottom: 0.8rem; 
  }

  .terminal-title { 
    font-family: 'Orbitron', sans-serif; 
    font-size: 2.6rem; 
    margin: 0; 
    color: var(--text-primary); 
    letter-spacing: 2px; 
  }

  .terminal-sub { 
    color: var(--text-secondary); 
    font-size: 1.1rem; 
    margin: 0.6rem 0 1.5rem; 
  }

  .filter-bar {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .filter-btn {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(224, 225, 221, 0.15);
    color: var(--text-secondary);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent-crimson);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-crimson);
    border-color: var(--accent-crimson);
    color: white;
    box-shadow: 0 0 10px rgba(230, 57, 70, 0.4);
  }

  .posts-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); 
    gap: 1.5rem; 
  }

  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Ocultar posts no filtro */
  .post-card.is-hidden {
    display: none !important;
  }

  .hud-card { 
    background: var(--bg-surface); 
    border: 1px solid rgba(224,225,221,0.1); 
    border-radius: 6px; 
    padding: 1.5rem; 
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .hud-card:hover { 
    border-color: rgba(230,57,70,0.5); 
    transform: translateY(-2px);
  }

  .card-title { font-family: 'Rajdhani', sans-serif; font-size: 1.35rem; margin: 0.3rem 0 0.5rem; color: var(--text-primary); }
  .card-desc { color: var(--text-secondary); margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.5; }
  .card-meta { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.4rem; }
  
  .category-tag { font-weight: 700; color: var(--accent-blue); }
  .cat-avian { color: #4CC9F0; }
  .cat-rpg { color: #9D4EDD; }
  .cat-gaming { color: #F72585; }
  .cat-narrativas { color: #F4A261; }
  .cat-nexus { color: #2A9D8F; }

  .star-rating { color: #F4A261; }

  .post-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
  }

  .card-actions-terminal { display: flex; justify-content: flex-end; margin-top: auto; }
  .btn-link { color: var(--accent-blue); text-decoration: none; font-size: 0.9rem; font-weight: 600; }
  .btn-link:hover { color: var(--accent-crimson); }

  .footer { 
    text-align: center; 
    padding: 3rem 0; 
    color: var(--text-secondary); 
    font-size: 0.85rem; 
    border-top: 1px solid rgba(224,225,221,0.05); 
    margin-top: 4rem; 
  }

  .mt-3 { margin-top: 1rem; }

  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .terminal-title { font-size: 2rem; }
  }
</style>