---
// src/pages/dossier.astro
import NavLogo from '../components/NavLogo.astro';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>DOSSIÊ // @w4kkomancer_ - BEYOND OBVIOUS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- NAVEGAÇÃO -->
  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="/#stream" data-pt="Transmissões" data-en="Streams">Transmissões</a>
        <a href="/terminal" data-pt="Terminal" data-en="Terminal">Terminal</a>
        <a href="/dossier" class="active" data-pt="Dossiê" data-en="Dossier">Dossiê</a>
        <a href="/about" data-pt="Sobre" data-en="About">Sobre</a>
        <a href="/#signal" data-pt="Sinal" data-en="Signal">Sinal</a>
        <button id="lang-toggle" class="lang-btn">EN</button>
      </div>
    </div>
  </nav>

  <main class="container">
    
    <!-- CABEÇALHO DO DOSSIÊ -->
    <header class="dossier-header">
      <div class="status-badge" data-pt="◈ ARQUIVO CLASSIFICADO // NÍVEL DE ACESSO: RESTRITO" data-en="◈ CLASSIFIED FILE // CLEARANCE LEVEL: RESTRICTED">
        ◈ ARQUIVO CLASSIFICADO // NÍVEL DE ACESSO: RESTRITO
      </div>
      <h1 class="dossier-title">DOSSIÊ // W4KKOMANCER_</h1>
      <p class="dossier-sub">REGISTRO: #NEXUS-001 • <span data-pt="ARQUÉTIPO: TECNOMAGO DE FRONTEIRA" data-en="ARCHETYPE: FRONTIER TECHNOMANCER">ARQUÉTIPO: TECNOMAGO DE FRONTEIRA</span></p>
    </header>

    <!-- FICHA TÉCNICA BIOMÉTRICA (HUD) -->
    <section class="section">
      <div class="hud-card dossier-summary-card">
        <div class="crest-corner top-left"></div>
        <div class="crest-corner top-right"></div>
        <div class="crest-corner bottom-left"></div>
        <div class="crest-corner bottom-right"></div>

        <div class="spec-grid">
          <div class="spec-item">
            <span class="spec-label" data-pt="IDENTIFICADOR" data-en="IDENTIFIER">IDENTIFICADOR</span>
            <span class="spec-value text-crimson">@w4kkomancer_</span>
          </div>
          <div class="spec-item">
            <span class="spec-label" data-pt="SISTEMA NATIVO" data-en="NATIVE SYSTEM">SISTEMA NATIVO</span>
            <span class="spec-value text-blue">Nexus Net-Arcana</span>
          </div>
          <div class="spec-item">
            <span class="spec-label" data-pt="CLASSE PRIMÁRIA" data-en="PRIMARY CLASS">CLASSE PRIMÁRIA</span>
            <span class="spec-value">Deckmancer / Storyteller</span>
          </div>
          <div class="spec-item">
            <span class="spec-label" data-pt="STATUS DE TRANSMISSÃO" data-en="BROADCAST STATUS">STATUS DE TRANSMISSÃO</span>
            <span class="spec-value text-green">ONLINE // CANAL ATIVO</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 // ORIGEM E DESPERTAR -->
    <section class="section">
      <h2 class="section-title">01 // <span data-pt="A ORIGEM // O DESPERTAR ARCIBERNÉTICO" data-en="ORIGIN // THE ARCYBERNETIC AWAKENING">A ORIGEM // O DESPERTAR ARCIBERNÉTICO</span></h2>
      <div class="hud-card">
        <p data-pt="No limiar entre o código binário e o fluxo etéreo das linhas de ley, a maioria dos operadores escolhe um lado: ou mergulham no silício corporativo, ou buscam as tradições arcanas esquecidas. w4kkomancer_ descobriu que os dois mundos compartilham a mesma sintaxe fundamental." data-en="At the threshold between binary code and the ethereal flow of ley lines, most runners pick a side: they either dive into corporate silicon or unearth forgotten arcane traditions. w4kkomancer_ uncovered that both realms share the exact same fundamental syntax.">
          No limiar entre o código binário e o fluxo etéreo das linhas de ley, a maioria dos operadores escolhe um lado: ou mergulham no silício corporativo, ou buscam as tradições arcanas esquecidas. w4kkomancer_ descobriu que os dois mundos compartilham a mesma sintaxe fundamental.
        </p>
        <p class="mt-3" data-pt="Durante uma incursão profunda em nós não mapeados da matrix, um vazamento de energia mística colidiu com compiladores neurais. A fusão não corrompeu os sistemas — transformou dados brutos em magia canalizável. Hoje, operando a partir do porto seguro Beyond Obvious, ele transmite análises, crônicas de RPG e partidas táticas para quem ousa olhar além da superfície da rede." data-en="During a deep run into unmapped matrix nodes, a mystical energy leak collided with neural compilers. The fusion didn't corrupt the systems — it turned raw data into channelable sorcery. Today, broadcasting from the Beyond Obvious haven, he transmits reviews, tabletop chronicles, and tactical matches for those daring to look beyond the network's surface.">
          Durante uma incursão profunda em nós não mapeados da matrix, um vazamento de energia mística colidiu com compiladores neurais. A fusão não corrompeu os sistemas — transformou dados brutos em magia canalizável. Hoje, operando a partir do porto seguro Beyond Obvious, ele transmite análises, crônicas de RPG e partidas táticas para quem ousa olhar além da superfície da rede.
        </p>
      </div>
    </section>

    <!-- 02 // COMPANIONS & DAEMONS -->
    <section class="section">
      <h2 class="section-title">02 // <span data-pt="MÓDULOS FAMILIARES // M.I.A.U. & C.O.R.V.O." data-en="FAMILIAR MODULES // M.I.A.U. & C.O.R.V.O.">MÓDULOS FAMILIARES // M.I.A.U. & C.O.R.V.O.</span></h2>
      <div class="companions-grid">
        
        <!-- M.I.A.U. -->
        <div class="hud-card companion-card card-miau">
          <div class="companion-header">
            <span class="companion-icon">🐱</span>
            <div>
              <h3 class="companion-name text-blue">M.I.A.U.</h3>
              <span class="companion-role" data-pt="Módulo de Interceptação Arcana e Utilidades" data-en="Arcane Interception & Utility Module">Módulo de Interceptação Arcana e Utilidades</span>
            </div>
          </div>
          <p class="companion-desc" data-pt="Constructo espectral com interface felina bio-digital. M.I.A.U. atua como âncora de estabilização mágica no ombro do tecnomago, absorvendo picos de estática na transmissão e interagindo com o chat em tempo real." data-en="Spectral construct with a bio-digital feline interface. M.I.A.U. serves as an arcane grounding anchor on the technomancer's shoulder, absorbing stream static spikes and monitoring live interactions.">
            Constructo espectral com interface felina bio-digital. M.I.A.U. atua como âncora de estabilização mágica no ombro do tecnomago, absorvendo picos de estática na transmissão e interagindo com o chat em tempo real.
          </p>
          <div class="tag-row mt-3">
            <span class="tag tag-cyan">FREQUÊNCIA: 4CC9F0</span>
            <span class="tag" data-pt="STATUS: ATIVO NO OMBRO" data-en="STATUS: MOUNTED ON SHOULDER">STATUS: ATIVO NO OMBRO</span>
          </div>
        </div>

        <!-- C.O.R.V.O. -->
        <div class="hud-card companion-card card-corvo">
          <div class="companion-header">
            <span class="companion-icon">🦅</span>
            <div>
              <h3 class="companion-name text-crimson">C.O.R.V.O.</h3>
              <span class="companion-role" data-pt="Compilador Operacional de Reconhecimento e Vigilância" data-en="Operational Recon & Vigilance Compiler">Compilador Operacional de Reconhecimento e Vigilância</span>
            </div>
          </div>
          <p class="companion-desc" data-pt="Daemon autônomo de patrulha profunda. Sobrevoa as camadas mais densas da rede, blindando o canal contra invasões corporativas e arquivando fragmentos perdidos da wiki do mundo de Avian." data-en="Autonomous deep-patrol daemon. It soars across denser network layers, shielding the transmission against corporate ICE and compiling lost lore fragments from the Avian world wiki.">
            Daemon autônomo de patrulha profunda. Sobrevoa as camadas mais densas da rede, blindando o canal contra invasões corporativas e arquivando fragmentos perdidos da wiki do mundo de Avian.
          </p>
          <div class="tag-row mt-3">
            <span class="tag tag-crimson">FREQUÊNCIA: E63946</span>
            <span class="tag" data-pt="STATUS: PATRULHA PROFUNDA" data-en="STATUS: DEEP PATROL">STATUS: PATRULHA PROFUNDA</span>
          </div>
        </div>

      </div>
    </section>

    <!-- 03 // ARSENAL TECNOMÁGICO -->
    <section class="section">
      <h2 class="section-title">03 // <span data-pt="ARSENAL & HABILIDADES" data-en="ARSENAL & ABILITIES">ARSENAL & HABILIDADES</span></h2>
      <div class="arsenal-grid">
        
        <div class="hud-card">
          <h3 class="card-title text-blue">🃏 DECKMANCY // CÁLCULO DE PROBABILIDADE</h3>
          <p class="card-desc" data-pt="Capacidade de ler micro-padrões e compilar sinergias em milissegundos. Manifesta-se no domínio tático de jogos de cartas como Marvel SNAP e mecânicas de duelo rápido." data-en="Ability to read micro-patterns and compile synergies in milliseconds. Demonstrated in tactical card masteries like Marvel SNAP and rapid duel mechanics.">
            Capacidade de ler micro-padrões e compilar sinergias em milissegundos. Manifesta-se no domínio tático de jogos de cartas como Marvel SNAP e mecânicas de duelo rápido.
          </p>
        </div>

        <div class="hud-card">
          <h3 class="card-title text-purple">🎲 WORLD FORGING // AVANÇO ARCANO</h3>
          <p class="card-desc" data-pt="Criação de realidades e ecossistemas inteiros através da narrativa de RPG. Autor e Mestre de Avian, construindo histórias com consequências pesadas e mundos vivos." data-en="Forging complete ecosystems and timelines via tabletop narrative engines. Author and GM of Avian, crafting high-stakes storytelling and reactive universes.">
            Criação de realidades e ecossistemas inteiros através da narrativa de RPG. Autor e Mestre de Avian, construindo histórias com consequências pesadas e mundos vivos.
          </p>
        </div>

        <div class="hud-card">
          <h3 class="card-title text-gold">👁️ CYBER-IMPLANTES VISUAIS</h3>
          <p class="card-desc" data-pt="Lentes de espectro duplo capazes de enxergar subtextos narrativos, pistas ocultas em jogos de aventura e desconstruir teorias de ficção científica complexas." data-en="Dual-spectrum optical lenses designed to perceive narrative subtext, uncover hidden game clues, and deconstruct complex sci-fi theories.">
            Lentes de espectro duplo capazes de enxergar subtextos narrativos, pistas ocultas em jogos de aventura e desconstruir teorias de ficção científica complexas.
          </p>
        </div>

      </div>
    </section>

    <!-- 04 // DIRETRIZES DO NEXUS -->
    <section class="section">
      <h2 class="section-title">04 // <span data-pt="DIRETRIZES DO NEXUS // COMUNIDADE" data-en="NEXUS PROTOCOLS // COMMUNITY">DIRETRIZES DO NEXUS // COMUNIDADE</span></h2>
      <div class="hud-card">
        <ul class="dossier-list">
          <li>
            <strong class="text-blue" data-pt="AGENTES DO NEXUS:" data-en="NEXUS AGENTS:">AGENTES DO NEXUS:</strong> 
            <span data-pt="Como são designados os exploradores, inscritos e membros que sintonizam a transmissão." data-en="How viewers, subscribers, and community explorers tuning into the broadcast are designated.">Como são designados os exploradores, inscritos e membros que sintonizam a transmissão.</span>
          </li>
          <li>
            <strong class="text-crimson" data-pt="BORDÃO DE ACESSO:" data-en="ACCESS PHRASE:">BORDÃO DE ACESSO:</strong> 
            <span>"Onde a lógica encontra o mistério e as narrativas vão além do óbvio."</span>
          </li>
          <li>
            <strong class="text-green" data-pt="TAGS DE MONITORAMENTO:" data-en="TRACKING TAGS:">TAGS DE MONITORAMENTO:</strong> 
            <span>#BeyondLive • #w4kkoArt • #NexusLore • #ArcanoAtivo</span>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <!-- RODAPÉ -->
  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @w4kkomancer_</p>
  </footer>

  <!-- SCRIPT DE TRADUÇÃO -->
  <script>
    const toggleBtn = document.getElementById('lang-toggle');
    let currentLang = localStorage.getItem('siteLang') || 'pt';

    const applyLanguage = () => {
      if (toggleBtn) {
        toggleBtn.textContent = currentLang === 'pt' ? 'EN' : 'PT';
      }
      document.querySelectorAll('[data-pt]').forEach(el => {
        const target = el as HTMLElement;
        target.innerHTML = currentLang === 'pt' ? target.dataset.pt! : target.dataset.en!;
      });
    };

    if (currentLang === 'en') {
      applyLanguage();
    }

    toggleBtn?.addEventListener('click', () => {
      currentLang = currentLang === 'pt' ? 'en' : 'pt';
      localStorage.setItem('siteLang', currentLang);
      applyLanguage();
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --accent-purple: #9D4EDD;
    --accent-pink: #F72585;
    --accent-gold: #F4A261;
    --accent-green: #2A9D8F;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }

  /* NAVEGAÇÃO */
  .nav-bar { 
    background: rgba(11, 12, 16, 0.95); 
    border-bottom: 1px solid rgba(230, 57, 70, 0.2); 
    position: sticky; 
    top: 0; 
    backdrop-filter: blur(10px); 
    z-index: 100; 
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-container { 
    width: 100%;
    max-width: 960px; 
    margin: 0 auto; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 1.5rem; 
  }
  
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }

  .nav-links a { 
    color: var(--text-secondary); 
    text-decoration: none; 
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem; 
    font-weight: 600; 
    transition: color 0.2s ease;
  }

  .nav-links a:hover, .nav-links a.active { color: var(--accent-crimson); }

  .lang-btn { 
    background: transparent; 
    border: 1px solid var(--accent-blue); 
    color: var(--accent-blue); 
    padding: 0.2rem 0.6rem; 
    border-radius: 4px; 
    cursor: pointer; 
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700; 
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .lang-btn:hover { 
    background: rgba(76, 201, 240, 0.15); 
    box-shadow: 0 0 8px rgba(76, 201, 240, 0.4); 
  }

  /* CABEÇALHO DO DOSSIÊ */
  .dossier-header {
    padding: 3rem 0 1.5rem;
  }

  .status-badge { 
    display: inline-block; 
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.8rem; 
    letter-spacing: 1.5px;
    color: var(--accent-crimson); 
    border: 1px solid rgba(230, 57, 70, 0.4); 
    padding: 0.3rem 0.8rem; 
    border-radius: 4px; 
    margin-bottom: 0.8rem; 
    background: rgba(230, 57, 70, 0.08);
  }

  .dossier-title { 
    font-family: 'Orbitron', sans-serif; 
    font-size: 2.3rem; 
    margin: 0; 
    color: var(--text-primary); 
    letter-spacing: 2px; 
    line-height: 1.1; 
  }

  .dossier-sub { 
    color: var(--accent-blue); 
    font-family: 'Rajdhani', sans-serif; 
    font-size: 1.1rem; 
    font-weight: 700; 
    margin: 0.4rem 0 0; 
    letter-spacing: 1px;
  }

  /* SEÇÕES & CARDS */
  .section { padding: 1.5rem 0 0.5rem; }

  .section-title { 
    font-family: 'Rajdhani', sans-serif; 
    font-size: 1.35rem; 
    color: var(--accent-crimson); 
    margin: 0 0 1rem; 
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 0.4rem;
    letter-spacing: 1px;
  }

  .hud-card { 
    background: var(--bg-surface); 
    border: 1px solid rgba(224, 225, 221, 0.1); 
    border-radius: 6px; 
    padding: 1.5rem; 
  }

  /* FICHA BIOMÉTRICA */
  .dossier-summary-card {
    position: relative;
    background: rgba(22, 24, 29, 0.8);
    border-color: rgba(76, 201, 240, 0.3);
  }

  .crest-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--accent-crimson);
  }
  .crest-corner.top-left { top: -1px; left: -1px; border-top: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.top-right { top: -1px; right: -1px; border-top: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-left { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-right { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-secondary);
  }

  .spec-value {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
  }

  /* COMPANIONS */
  .companions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .companion-card {
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card-miau:hover { border-color: var(--accent-blue); transform: translateY(-2px); }
  .card-corvo:hover { border-color: var(--accent-crimson); transform: translateY(-2px); }

  .companion-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .companion-icon { font-size: 1.8rem; }

  .companion-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.2rem;
    margin: 0;
    letter-spacing: 1.5px;
  }

  .companion-role {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .companion-desc {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin: 0;
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag { background: rgba(0,0,0,0.4); border: 1px solid rgba(224,225,221,0.1); font-size: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 3px; font-family: 'Rajdhani', sans-serif; font-weight: 700; }
  .tag-cyan { border-color: rgba(76, 201, 240, 0.4); color: var(--accent-blue); }
  .tag-crimson { border-color: rgba(230, 57, 70, 0.4); color: var(--accent-crimson); }

  /* ARSENAL */
  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
  }

  .card-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .card-desc {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.95rem;
  }

  /* LISTAS */
  .dossier-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: 0.95rem;
  }

  .dossier-list li {
    padding-left: 1.2rem;
    position: relative;
  }

  .dossier-list li::before {
    content: "◈";
    position: absolute;
    left: 0;
    color: var(--accent-blue);
    font-size: 0.8rem;
    top: 2px;
  }

  /* CORES UTILITÁRIAS */
  .text-crimson { color: var(--accent-crimson); }
  .text-blue { color: var(--accent-blue); }
  .text-purple { color: var(--accent-purple); }
  .text-gold { color: var(--accent-gold); }
  .text-green { color: var(--accent-green); }
  .mt-3 { margin-top: 1rem; }

  /* RODAPÉ */
  .footer { 
    text-align: center; 
    padding: 3rem 0; 
    color: var(--text-secondary); 
    font-size: 0.85rem; 
    border-top: 1px solid rgba(224,225,221,0.05); 
    margin-top: 4rem; 
  }

  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .dossier-title { font-size: 1.8rem; }
    .spec-grid { grid-template-columns: 1fr; }
  }
</style>