---
// src/pages/grimorio.astro
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, GRIMORIO_ITEMS } from '../data/grimorio';

const categoriesList = Object.values(CATEGORIES);
const featuredCount = GRIMORIO_ITEMS.filter((item) => item.isFeatured).length;

const CATEGORY_TRANSLATIONS: Record<string, { pt: string; en: string }> = {
  ttrpg: { pt: 'TTRPG & WORLDBUILDING', en: 'TTRPG & WORLDBUILDING' },
  gaming: { pt: 'GAMES & ESTRATÉGIA', en: 'GAMES & STRATEGY' },
  boardgames: { pt: 'JOGOS DE TABULEIRO', en: 'BOARD GAMES' },
  tech: { pt: 'DEV & DIGITAL ARCANUM', en: 'DEV & DIGITAL ARCANUM' },
  stream: { pt: 'VTUBERS & TRANSMISSÃO', en: 'VTUBERS & BROADCAST' },
  cinema: { pt: 'CINEMA, ANIME & SÉRIES', en: 'CINEMA, ANIME & SERIES' },
  books: { pt: 'LEITURA & NARRATIVA', en: 'READING & NARRATIVE' },
};
---

<Layout
  title="GRIMÓRIO // REPERTÓRIO DE HIPERLINKS - BEYOND OBVIOUS"
  currentPage="grimorio"
>
  <div class="grimorio-container">
    <!-- CABEÇALHO DO GRIMÓRIO -->
    <header class="grimorio-header">
      <div
        class="status-tag"
        data-pt="SYS_ARCHIVE // TOMO ARCANO ATIVO"
        data-en="SYS_ARCHIVE // ACTIVE ARCANUM TOME"
      >
        <span class="pulse-dot"></span>
        <span class="status-tag-text">SYS_ARCHIVE // TOMO ARCANO ATIVO</span>
      </div>
      <h1 class="page-title" data-pt="// GRIMÓRIO" data-en="// GRIMOIRE">// GRIMÓRIO</h1>
      <p
        class="page-subtitle"
        data-pt="Compêndio de ferramentas, artefatos, repositórios e frequências homologadas pelo Operador."
        data-en="Compendium of tools, artifacts, repositories, and frequencies approved by the Operator."
      >
        Compêndio de ferramentas, artefatos, repositórios e frequências homologadas pelo Operador.
      </p>
    </header>

    <!-- PAINEL DE CONTROLE: PESQUISA E FILTROS -->
    <section class="control-panel">
      <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          id="search-input"
          placeholder="Consultar grimório por nome, tecnologia, palavra-chave..."
          data-placeholder-pt="Consultar grimório por nome, tecnologia, palavra-chave..."
          data-placeholder-en="Search grimoire by name, technology, keyword..."
          autocomplete="off"
        />
      </div>

      <nav class="filter-bar" aria-label="Filtros por categoria">
        <!-- BOTÃO DESTAQUES -->
        <button
          class="filter-btn featured-filter active"
          data-filter="featured"
          data-pt="★ DESTAQUES"
          data-en="★ FEATURED"
        >
          <span class="btn-icon">★</span>
          <span class="filter-label">DESTAQUES</span>
          <span class="counter">({featuredCount})</span>
        </button>

        <!-- BOTÃO TODOS -->
        <button
          class="filter-btn"
          data-filter="all"
          data-pt="◈ TODOS"
          data-en="◈ ALL"
        >
          <span class="btn-icon">◈</span>
          <span class="filter-label">TODOS</span>
          <span class="counter">({GRIMORIO_ITEMS.length})</span>
        </button>

        <!-- CATEGORIAS DINÂMICAS -->
        {categoriesList.map((cat) => {
          const count = GRIMORIO_ITEMS.filter((item) => item.category === cat.id).length;
          const trans = CATEGORY_TRANSLATIONS[cat.id] || { pt: cat.label, en: cat.label };
          return (
            <button
              class="filter-btn"
              data-filter={cat.id}
              data-pt={trans.pt}
              data-en={trans.en}
            >
              <span class="btn-icon">{cat.icon}</span>
              <span class="filter-label">{trans.pt}</span>
              <span class="counter">({count})</span>
            </button>
          );
        })}
      </nav>

      <div class="results-meta">
        <span id="results-count">Exibindo {featuredCount} destaques de {GRIMORIO_ITEMS.length} registros</span>
      </div>
    </section>

    <!-- GRID DE CARDS DO GRIMÓRIO -->
    <section class="links-grid" id="links-container">
      {GRIMORIO_ITEMS.map((item) => {
        const catInfo = CATEGORIES[item.category];
        const trans = CATEGORY_TRANSLATIONS[item.category] || { pt: catInfo.label, en: catInfo.label };
        return (
          <article
            class="grimorio-card"
            data-category={item.category}
            data-featured={item.isFeatured ? "true" : "false"}
            data-title={item.title.toLowerCase()}
            data-desc={item.description.toLowerCase()}
            data-badge={item.badge ? item.badge.toLowerCase() : ''}
            style={item.isFeatured ? "display: flex;" : "display: none;"}
          >
            <div class="crest-corner top-left"></div>
            <div class="crest-corner top-right"></div>
            <div class="crest-corner bottom-left"></div>
            <div class="crest-corner bottom-right"></div>

            <div class="card-meta">
              <span
                class={`category-tag ${catInfo.badgeClass}`}
                data-pt={`${catInfo.icon} ${trans.pt}`}
                data-en={`${catInfo.icon} ${trans.en}`}
              >
                {catInfo.icon} {trans.pt}
              </span>
              {item.badge && <span class="sub-badge">{item.badge}</span>}
              {item.isFeatured && (
                <span
                  class="featured-badge"
                  data-pt="★ DESTAQUE"
                  data-en="★ FEATURED"
                >
                  ★ DESTAQUE
                </span>
              )}
            </div>

            <h2 class="item-title">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                <span>{item.title}</span>
                <span class="arrow-glyph">&nearr;</span>
              </a>
            </h2>

            <p class="item-desc">{item.description}</p>

            <footer class="card-footer">
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-url">
                {item.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </footer>
          </article>
        );
      })}
    </section>

    <!-- ESTADO VAZIO -->
    <div id="no-results" class="no-results hidden">
      <p
        class="error-code"
        data-pt="404 // ARTEFATO NÃO ENCONTRADO"
        data-en="404 // ARTIFACT NOT FOUND"
      >
        404 // ARTEFATO NÃO ENCONTRADO
      </p>
      <p
        class="error-desc"
        data-pt="Nenhum registro correspondente à consulta no Grimório."
        data-en="No matching records found for the queried frequency in the Grimoire."
      >
        Nenhum registro correspondente à consulta no Grimório.
      </p>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.grimorio-card');
  const noResults = document.getElementById('no-results');
  const resultsCount = document.getElementById('results-count');
  const langToggleBtn = document.getElementById('lang-toggle');
  const totalItems = cards.length;

  let activeCategory = 'featured';
  let searchTerm = '';

  function getCurrentLang(): 'pt' | 'en' {
    return langToggleBtn?.textContent?.trim().toUpperCase() === 'PT' ? 'en' : 'pt';
  }

  function updateResultsCounter(visibleCount: number) {
    if (!resultsCount) return;
    const lang = getCurrentLang();

    if (lang === 'en') {
      if (activeCategory === 'featured' && !searchTerm) {
        resultsCount.textContent = `Showing ${visibleCount} featured items of ${totalItems} records`;
      } else {
        resultsCount.textContent = `Showing ${visibleCount} of ${totalItems} records`;
      }
    } else {
      if (activeCategory === 'featured' && !searchTerm) {
        resultsCount.textContent = `Exibindo ${visibleCount} destaques de ${totalItems} registros`;
      } else {
        resultsCount.textContent = `Exibindo ${visibleCount} de ${totalItems} registros`;
      }
    }
  }

  function updateInputPlaceholder() {
    if (!searchInput) return;
    const lang = getCurrentLang();
    const ph = lang === 'en'
      ? searchInput.getAttribute('data-placeholder-en')
      : searchInput.getAttribute('data-placeholder-pt');
    if (ph) searchInput.placeholder = ph;
  }

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const isCardFeatured = card.getAttribute('data-featured') === 'true';
      const cardTitle = card.getAttribute('data-title') || '';
      const cardDesc = card.getAttribute('data-desc') || '';
      const cardBadge = card.getAttribute('data-badge') || '';

      let matchesCat = false;
      if (searchTerm) {
        matchesCat = activeCategory === 'all' || activeCategory === 'featured' || cardCat === activeCategory;
      } else {
        if (activeCategory === 'featured') {
          matchesCat = isCardFeatured;
        } else if (activeCategory === 'all') {
          matchesCat = true;
        } else {
          matchesCat = cardCat === activeCategory;
        }
      }

      const matchesSearch =
        !searchTerm ||
        cardTitle.includes(searchTerm) ||
        cardDesc.includes(searchTerm) ||
        cardBadge.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    updateResultsCounter(visibleCount);

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-filter') || 'featured';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  // Atualiza os contadores dinâmicos e o placeholder quando o idioma for alternado no Header
  langToggleBtn?.addEventListener('click', () => {
    setTimeout(() => {
      applyFilters();
      updateInputPlaceholder();
    }, 50);
  });
</script>

<style>
  .grimorio-container {
    padding: 1.5rem 0 3.5rem;
  }

  .grimorio-header {
    margin-bottom: 1.8rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 1.2rem;
  }

  .status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent-blue, #4CC9F0);
    background: rgba(76, 201, 240, 0.08);
    border: 1px solid rgba(76, 201, 240, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.8rem;
  }

  .pulse-dot {
    width: 5px;
    height: 5px;
    background-color: var(--accent-blue, #4CC9F0);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-blue, #4CC9F0);
  }

  .page-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.1rem;
    color: var(--text-primary, #E0E1DD);
    margin: 0 0 0.4rem;
    letter-spacing: 1.5px;
  }

  .page-subtitle {
    color: var(--text-secondary, #8D99AE);
    font-size: 0.95rem;
    max-width: 700px;
    line-height: 1.5;
    margin: 0;
  }

  /* BARRA DE CONTROLE */
  .control-panel {
    margin-bottom: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .search-wrapper {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.85rem;
    opacity: 0.6;
  }

  #search-input {
    width: 100%;
    padding: 0.7rem 1rem 0.7rem 2.4rem;
    background: rgba(11, 12, 16, 0.85);
    border: 1px solid rgba(224, 225, 221, 0.15);
    border-radius: 4px;
    color: var(--text-primary, #E0E1DD);
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  #search-input:focus {
    outline: none;
    border-color: var(--accent-blue, #4CC9F0);
    box-shadow: 0 0 10px rgba(76, 201, 240, 0.25);
  }

  /* FILTROS */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-btn {
    background: rgba(22, 24, 29, 0.7);
    border: 1px solid rgba(224, 225, 221, 0.1);
    color: var(--text-secondary, #8D99AE);
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent-blue, #4CC9F0);
    color: var(--text-primary, #E0E1DD);
    background: rgba(76, 201, 240, 0.1);
  }

  .filter-btn.active {
    background: var(--accent-crimson, #E63946);
    border-color: var(--accent-crimson, #E63946);
    color: #fff;
    box-shadow: 0 0 8px rgba(230, 57, 70, 0.35);
  }

  .filter-btn.featured-filter.active {
    background: var(--accent-gold, #F4A261);
    border-color: var(--accent-gold, #F4A261);
    color: #111;
    box-shadow: 0 0 8px rgba(244, 162, 97, 0.35);
  }

  .counter {
    opacity: 0.7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
  }

  .results-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-secondary, #8D99AE);
    padding-left: 0.2rem;
  }

  /* GRID DE CARDS */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .grimorio-card {
    background: var(--bg-surface, #16181D);
    border: 1px solid rgba(224, 225, 221, 0.1);
    border-radius: 4px;
    padding: 1rem 1.1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 150px;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .grimorio-card:hover {
    transform: translateY(-2px);
    border-color: rgba(76, 201, 240, 0.4);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
  }

  .crest-corner {
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: var(--accent-crimson, #E63946);
    pointer-events: none;
  }

  .top-left { top: 0; left: 0; border-top: 2px solid; border-left: 2px solid; }
  .top-right { top: 0; right: 0; border-top: 2px solid; border-right: 2px solid; }
  .bottom-left { bottom: 0; left: 0; border-bottom: 2px solid; border-left: 2px solid; }
  .bottom-right { bottom: 0; right: 0; border-bottom: 2px solid; border-right: 2px solid; }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .category-tag {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.4px;
  }

  .cat-ttrpg { color: var(--accent-purple, #9D4EDD); }
  .cat-gaming { color: var(--accent-crimson, #E63946); }
  .cat-boardgames { color: var(--accent-gold, #F4A261); }
  .cat-tech { color: var(--accent-green, #2A9D8F); }
  .cat-stream { color: var(--accent-blue, #4CC9F0); }
  .cat-cinema { color: var(--accent-pink, #F72585); }
  .cat-books { color: var(--text-primary, #E0E1DD); }

  .sub-badge {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    color: var(--text-secondary, #8D99AE);
  }

  .featured-badge {
    color: var(--accent-gold, #F4A261);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.7rem;
  }

  .item-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    line-height: 1.25;
  }

  .item-title a {
    color: var(--text-primary, #E0E1DD);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s ease;
  }

  .arrow-glyph {
    color: var(--accent-blue, #4CC9F0);
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .item-title a:hover {
    color: var(--accent-blue, #4CC9F0);
  }

  .item-title a:hover .arrow-glyph {
    transform: translate(2px, -2px);
    color: var(--accent-crimson, #E63946);
  }

  .item-desc {
    color: var(--text-secondary, #8D99AE);
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0 0 0.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    border-top: 1px solid rgba(224, 225, 221, 0.06);
    padding-top: 0.5rem;
  }

  .link-url {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: rgba(76, 201, 240, 0.65);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    transition: color 0.2s ease;
  }

  .link-url:hover {
    color: var(--accent-blue, #4CC9F0);
    text-decoration: underline;
  }

  .no-results {
    text-align: center;
    padding: 3.5rem 1rem;
    color: var(--text-secondary, #8D99AE);
  }

  .no-results .error-code {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1rem;
    color: var(--accent-crimson, #E63946);
    margin-bottom: 0.4rem;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .page-title { font-size: 1.8rem; }
    .links-grid { grid-template-columns: 1fr; }
  }
</style>