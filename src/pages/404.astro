---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 // SINAL INTERROMPIDO - BEYOND OBVIOUS" currentPage="404">
  <div class="error-section">
    <div class="hud-card error-card">
      <div class="crest-corner top-left"></div>
      <div class="crest-corner top-right"></div>
      <div class="crest-corner bottom-left"></div>
      <div class="crest-corner bottom-right"></div>

      <!-- STATUS BADGE -->
      <div class="status-badge badge-crimson" data-pt="⚠ ALERTA CRÍTICO // COORDENADA NÃO ENCONTRADA" data-en="⚠ CRITICAL ALERT // COORDINATE NOT FOUND">
        ⚠ ALERTA CRÍTICO // COORDENADA NÃO ENCONTRADA
      </div>

      <!-- CÓDIGO 404 GLITCH -->
      <div class="glitch-wrapper">
        <h1 class="error-code" data-text="404">404</h1>
      </div>

      <h2 class="error-title" data-pt="SINAL CORROMPIDO NA MALHA ARCANA" data-en="SIGNAL CORRUPTED IN THE ARCANE MATRIX">
        SINAL CORROMPIDO NA MALHA ARCANA
      </h2>

      <!-- BOX DE DIAGNÓSTICO -->
      <div class="terminal-log-box">
        <p class="log-line text-crimson">> ERR_NEXUS_NODE_NULL: Pacote de dados desintegrado no éter.</p>
        <p class="log-line text-secondary" data-pt="> Diagnóstico: O registro solicitado foi expurgado, movido ou nunca existiu nesta dimensão." data-en="> Diagnostic: The requested record was purged, relocated, or never existed in this dimension.">
          > Diagnóstico: O registro solicitado foi expurgado, movido ou nunca existiu nesta dimensão.
        </p>
        <p class="log-line text-blue" data-pt="> Sugestão: Recalibre seus sensores e retorne à frequência central." data-en="> Suggestion: Recalibrate your sensors and return to the main frequency.">
          > Sugestão: Recalibre seus sensores e retorne à frequência central.
        </p>
      </div>

      <!-- BOTÕES DE AÇÃO -->
      <div class="error-actions">
        <a href="/" class="btn btn-primary" data-pt="⚡ RETORNAR AO NEXUS (HOME)" data-en="⚡ RETURN TO NEXUS (HOME)">
          ⚡ RETORNAR AO NEXUS (HOME)
        </a>
        <a href="/terminal" class="btn btn-outline" data-pt="📜 CONSULTAR TERMINAL" data-en="📜 QUERY TERMINAL">
          📜 CONSULTAR TERMINAL
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 0;
    width: 100%;
  }

  .error-card {
    max-width: 650px;
    width: 100%;
    text-align: center;
    padding: 2.5rem 1.5rem;
    margin: 0 auto;
  }

  .badge-crimson {
    color: var(--accent-crimson, #E63946);
    border-color: rgba(230, 57, 70, 0.4);
    background: rgba(230, 57, 70, 0.08);
  }

  .glitch-wrapper {
    position: relative;
    display: inline-block;
    margin: 1rem 0;
  }

  .error-code {
    font-family: 'Orbitron', sans-serif;
    font-size: 5.5rem;
    font-weight: 900;
    margin: 0;
    line-height: 1;
    color: var(--text-primary, #E0E1DD);
    letter-spacing: 4px;
    position: relative;
    text-shadow: 0 0 20px rgba(230, 57, 70, 0.4);
  }

  .error-code::before,
  .error-code::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip: rect(0, 0, 0, 0);
  }

  .error-code::before {
    left: -2px;
    text-shadow: 2px 0 var(--accent-blue, #4CC9F0);
    animation: glitch-anim-1 2.5s infinite linear alternate-reverse;
  }

  .error-code::after {
    left: 2px;
    text-shadow: -2px 0 var(--accent-crimson, #E63946);
    animation: glitch-anim-2 3s infinite linear alternate-reverse;
  }

  @keyframes glitch-anim-1 {
    0% { clip: rect(20px, 9999px, 40px, 0); transform: skew(0.3deg); }
    20% { clip: rect(60px, 9999px, 80px, 0); transform: skew(-0.2deg); }
    40% { clip: rect(10px, 9999px, 30px, 0); transform: skew(0.5deg); }
    60% { clip: rect(70px, 9999px, 90px, 0); transform: skew(-0.3deg); }
    80% { clip: rect(30px, 9999px, 50px, 0); transform: skew(0.2deg); }
    100% { clip: rect(50px, 9999px, 70px, 0); transform: skew(-0.1deg); }
  }

  @keyframes glitch-anim-2 {
    0% { clip: rect(50px, 9999px, 70px, 0); transform: skew(-0.3deg); }
    25% { clip: rect(20px, 9999px, 40px, 0); transform: skew(0.2deg); }
    50% { clip: rect(80px, 9999px, 100px, 0); transform: skew(-0.5deg); }
    75% { clip: rect(10px, 9999px, 30px, 0); transform: skew(0.3deg); }
    100% { clip: rect(40px, 9999px, 60px, 0); transform: skew(-0.2deg); }
  }

  .error-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent-crimson, #E63946);
    letter-spacing: 1.5px;
    margin: 0 0 1.5rem;
  }

  .terminal-log-box {
    background: rgba(11, 12, 16, 0.85);
    border: 1px solid rgba(224, 225, 221, 0.1);
    border-radius: 4px;
    padding: 1rem 1.2rem;
    text-align: left;
    margin-bottom: 2rem;
    font-family: monospace;
    font-size: 0.85rem;
  }

  .log-line {
    margin: 0.3rem 0;
    line-height: 1.4;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .error-card { padding: 2rem 1rem; }
    .error-code { font-size: 4rem; }
    .error-title { font-size: 1.1rem; }
    .error-actions { flex-direction: column; }
    .error-actions .btn { width: 100%; }
  }
</style>