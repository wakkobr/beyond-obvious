---
// src/pages/avatares.astro
import Layout from '../layouts/Layout.astro';

// Lista expandida de Operadores do Hub
const avatares = [
  {
    name: "w4kkomancer_",
    handle: "@w4kkomancer_",
    rolePt: "Guardião do Nexus & Tecnomago",
    roleEn: "Nexus Warden & Technomancer",
    specialtyPt: "Storytelling, Deckmancia & RPG de Mesa",
    specialtyEn: "Storytelling, Deckmancy & Tabletop RPG",
    originNodePt: "Nó Primário // Beyond Obvious",
    originNodeEn: "Core Node // Beyond Obvious",
    nodeUrl: "/",
    avatar: "/images/w4kko-avatar.png",
    accentColor: "cyan",
    freq: "#4CC9F0",
    naturePt: "Tecnomante Errante // Guardião de Chave",
    natureEn: "Wandering Technomancer // Key Warden",
    primaryRolePt: "Amplificador de Sinal & Forja de Mundos",
    primaryRoleEn: "Signal Amplifier & Worldforging",
    activeSkillPt: "Cartomancia Rúnica / Sincronização do Nexus",
    activeSkillEn: "Runic Cartomancy / Nexus Synchronization",
    lorePt: "Mercenário clandestino do mundo de origem que escapou da Mega Corporação Neutron através de uma Brecha Dimensional. Sobreviveu à Fissura na Terra e estabeleceu o Beyond Obvious como um nódulo central de resistência e narração.",
    loreEn: "Underground mercenary from a home world who escaped the Neutron Mega Corporation through a Dimensional Breach. Survived the Earth Fissure and established Beyond Obvious as a central node for resistance and storytelling.",
    twitch: "https://twitch.tv/w4kkomancer_",
    youtube: "https://www.youtube.com/channel/UCqw0c6fhpxKFAb-eDPHDKew",
    x: "https://x.com/w4kkomancer_",
    dossier: "/dossier"
  },
  {
    name: "DeniLunae",
    handle: "@DeniLunae",
    rolePt: "Operadora de Sinal // Guardiã Lunar",
    roleEn: "Signal Operator // Lunar Guardian",
    specialtyPt: "Gaming, Variedades & Transmissões Noturnas",
    specialtyEn: "Gaming, Variety & Night Broadcasts",
    originNodePt: "Nexus de Vínculo // Moonhaven",
    originNodeEn: "Bond Nexus // Moonhaven",
    nodeUrl: "https://moonhaven.beyond-obvious.net",
    avatar: "/images/denilunae-avatar.png",
    accentColor: "purple",
    freq: "#9D4EDD",
    naturePt: "Guardiã Primordial dos Registros Celestiais",
    natureEn: "Primordial Guardian of Celestial Records",
    primaryRolePt: "Vínculo Lunar & Estabilização de Frequência",
    primaryRoleEn: "Lunar Bond & Frequency Stabilization",
    activeSkillPt: "Astrignis (Fogo Astral, Ciano e Violeta)",
    activeSkillEn: "Astrignis (Astral Fire, Cyan & Violet)",
    lorePt: "Originária das nebulosas de Virgem, opera a partir de Moonhaven como um subdomínio sintonizado ao Nexus. Conecta transmissões noturnas e vela pelos registros celestiais da malha arcano-digital.",
    loreEn: "Originating from the Virgo nebulae, operating from Moonhaven as a subdomain tuned to the Nexus. Connects night broadcasts and watches over the celestial records of the arcane-digital mesh.",
    twitch: "https://twitch.tv",
    youtube: "",
    x: "",
    dossier: ""
  }
];
---

<Layout title="AVATARES // REDE DE OPERADORES - BEYOND OBVIOUS" currentPage="avatares">
  
  <!-- CABEÇALHO DA PÁGINA (PADRÃO HUD UNIFICADO) -->
  <header class="page-header">
    <div class="status-badge" data-pt="◈ DIRETÓRIO DE SINAIS // REDE DESCENTRALIZADA DE AVATARES" data-en="◈ SIGNAL DIRECTORY // DECENTRALIZED AVATAR NETWORK">
      ◈ DIRETÓRIO DE SINAIS // REDE DESCENTRALIZADA DE AVATARES
    </div>
    <h1 class="page-title">// AVATARES & OPERADORES</h1>
    <p class="page-sub">
      <span data-pt="FREQUÊNCIAS ATIVAS" data-en="ACTIVE FREQUENCIES">FREQUÊNCIAS ATIVAS</span> • 
      <span class="text-dim" data-pt="Nexus de Vínculo sintonizados ao Nexus" data-en="Bond Nexuses tuned to the Nexus">Nexus de Vínculo sintonizados ao Nexus</span>
    </p>
  </header>

  <!-- INTRODUÇÃO DA SEÇÃO -->
  <section class="section">
    <div class="hud-card">
      <p class="section-lead" data-pt="O Beyond Obvious opera como um repetidor e amplificador de sinal para avatares virtuais e operadores independentes. Cada entidade sintonizada à malha comanda sua própria estação de transmissão e seu respectivo Nexus de Vínculo." data-en="Beyond Obvious operates as a signal relay and amplifier for virtual avatars and independent operators. Each entity synced to the grid commands their own broadcast relay and dedicated Bond Nexus.">
        O Beyond Obvious opera como um repetidor e amplificador de sinal para avatares virtuais e operadores independentes. Cada entidade sintonizada à malha comanda sua própria estação de transmissão e seu respectivo Nexus de Vínculo.
      </p>
    </div>
  </section>

  <!-- GRADE DE AVATARES (PADRÃO EXPANDIDO / COMPLETO) -->
  <section class="section">
    <div class="vtubers-grid">
      {avatares.map((vt) => (
        <div class={`hud-card vtuber-card border-${vt.accentColor}`}>
          <div class="crest-corner top-left"></div>
          <div class="crest-corner top-right"></div>
          <div class="crest-corner bottom-left"></div>
          <div class="crest-corner bottom-right"></div>

          <div class="vtuber-layout">
            <!-- AVATAR BOX -->
            <div class="avatar-col">
              <div class={`avatar-frame avatar-border-${vt.accentColor}`}>
                {vt.avatar ? (
                  <img 
                    src={vt.avatar} 
                    alt={vt.name} 
                    class="avatar-img" 
                    loading="lazy"
                  />
                ) : (
                  <div class="avatar-placeholder">
                    <span class="ph-glyph">◈</span>
                    <span class="ph-name">{vt.name}</span>
                    <span class="ph-note" data-pt="SINAL VIRTUAL" data-en="VIRTUAL SIGNAL">SINAL VIRTUAL</span>
                  </div>
                )}
              </div>
              <div class={`vt-status-tag tag-${vt.accentColor}`}>
                <span class={`pulse-dot-${vt.accentColor}`}></span>
                <span data-pt="SINAL SINTONIZADO" data-en="SIGNAL SYNCED">SINAL SINTONIZADO</span>
              </div>
            </div>

            <!-- INFO DO AVATAR -->
            <div class="vtuber-data-col">
              <div class="vtuber-title-bar">
                <div>
                  <h3 class={`vtuber-name text-${vt.accentColor}`}>{vt.name}</h3>
                  <span class="vtuber-handle">{vt.handle}</span>
                </div>
                <div class="vt-badges-right">
                  <span class={`frequency-chip text-${vt.accentColor}`}>FREQ: {vt.freq}</span>
                  {vt.nodeUrl && (
                    <a href={vt.nodeUrl} target={vt.nodeUrl.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer" class="node-badge" title="Acessar Nó do Operador">
                      🌐 <span data-pt={vt.originNodePt} data-en={vt.originNodeEn}>{vt.originNodePt}</span> &rarr;
                    </a>
                  )}
                </div>
              </div>

              <div class="vtuber-specs-table">
                <div class="vt-spec-row">
                  <span class="vt-label" data-pt="NATUREZA / MATRIZ:" data-en="NATURE / MATRIX:">NATUREZA / MATRIZ:</span>
                  <span class="vt-val" data-pt={vt.naturePt} data-en={vt.natureEn}>{vt.naturePt}</span>
                </div>
                <div class="vt-spec-row">
                  <span class="vt-label" data-pt="FUNÇÃO PRIMÁRIA:" data-en="PRIMARY ROLE:">FUNÇÃO PRIMÁRIA:</span>
                  <span class="vt-val" data-pt={vt.primaryRolePt} data-en={vt.primaryRoleEn}>{vt.primaryRolePt}</span>
                </div>
                <div class="vt-spec-row">
                  <span class="vt-label" data-pt="HABILIDADE ATIVA:" data-en="ACTIVE SKILL:">HABILIDADE ATIVA:</span>
                  <span class={`vt-val text-${vt.accentColor}`} data-pt={vt.activeSkillPt} data-en={vt.activeSkillEn}>{vt.activeSkillPt}</span>
                </div>
              </div>

              <div class="vtuber-lore-text mb-3">
                <p data-pt={vt.lorePt} data-en={vt.loreEn}>{vt.lorePt}</p>
              </div>

              <!-- LINKS DO AVATAR -->
              <div class="vtuber-links">
                {vt.nodeUrl && (
                  <a href={vt.nodeUrl} target={vt.nodeUrl.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer" class="vt-link-btn btn-node" data-pt="⚡ Nexus de Vínculo" data-en="⚡ Bond Nexus">
                    ⚡ Nexus de Vínculo
                  </a>
                )}
                {vt.twitch && vt.twitch !== "https://twitch.tv" && (
                  <a href={vt.twitch} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="Twitch">
                    🟣 Twitch
                  </a>
                )}
                {vt.youtube && (
                  <a href={vt.youtube} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="YouTube">
                    🔴 YouTube
                  </a>
                )}
                {vt.x && (
                  <a href={vt.x} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="X (Twitter)">
                    ✖️ X
                  </a>
                )}
                {vt.dossier && (
                  <a href={vt.dossier} class="vt-link-btn btn-dossier" data-pt="📁 Dossiê" data-en="📁 Dossier">
                    📁 Dossiê
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CARD DE CONVITE // ESTABELECER VÍNCULO -->
  <section class="section">
    <div class="hud-card join-network-card">
      <div class="join-info">
        <span class="join-tag" data-pt="EXPANSÃO DE MALHA" data-en="NETWORK EXPANSION">EXPANSÃO DE MALHA</span>
        <h3 class="join-title" data-pt="Comanda um Avatar ou Operação Virtual?" data-en="Command an Avatar or Virtual Operator?">Comanda um Avatar ou Operação Virtual?</h3>
        <p class="join-desc" data-pt="Estabeleça um vínculo de sinal com o Beyond Obvious para integrar transmissões sincronizadas, nós dedicados e campanhas compartilhadas." data-en="Establish a signal bond with Beyond Obvious to integrate synchronized broadcasts, dedicated nodes, and shared campaigns.">
          Estabeleça um vínculo de sinal com o Beyond Obvious para integrar transmissões sincronizadas, nós dedicados e campanhas compartilhadas.
        </p>
      </div>
      <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-pt="⚡ SINCRONIZAR SINAL" data-en="⚡ SYNC SIGNAL">
        ⚡ SINCRONIZAR SINAL
      </a>
    </div>
  </section>

</Layout>

<style>
  /* SEÇÕES & CARDS */
  .section { padding: 1.5rem 0 0.5rem; }

  /* AVATARES GRID */
  .vtubers-grid {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .vtuber-card {
    background: rgba(22, 24, 29, 0.95);
  }

  .border-cyan { border-color: rgba(76, 201, 240, 0.3); }
  .border-cyan:hover { border-color: var(--accent-blue); box-shadow: 0 0 16px rgba(76, 201, 240, 0.15); }
  
  .border-purple { border-color: rgba(157, 78, 221, 0.3); }
  .border-purple:hover { border-color: #9D4EDD; box-shadow: 0 0 16px rgba(157, 78, 221, 0.2); }

  .vtuber-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* AVATAR BOX & STATUS TAG */
  .avatar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .avatar-frame {
    width: 180px;
    height: 180px;
    background: rgba(11, 12, 16, 0.9);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .avatar-border-cyan { 
    border: 2px solid rgba(76, 201, 240, 0.4); 
    box-shadow: inset 0 0 15px rgba(76, 201, 240, 0.2);
  }
  .avatar-border-purple { 
    border: 2px solid rgba(157, 78, 221, 0.4); 
    box-shadow: inset 0 0 15px rgba(157, 78, 221, 0.2);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.3s ease;
  }

  .vtuber-card:hover .avatar-img {
    transform: scale(1.05);
  }

  .avatar-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem;
  }

  .ph-glyph { font-size: 1.5rem; color: var(--accent-blue); }
  .ph-name { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.8rem; color: var(--text-primary); }
  .ph-note { font-size: 0.65rem; color: var(--text-secondary); font-family: 'JetBrains Mono', monospace; }

  .vt-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 1px;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(224, 225, 221, 0.1);
  }

  .tag-cyan { color: var(--accent-blue); border-color: rgba(76, 201, 240, 0.4); }
  .tag-purple { color: #9D4EDD; border-color: rgba(157, 78, 221, 0.4); }

  .pulse-dot-cyan {
    width: 6px;
    height: 6px;
    background-color: var(--accent-blue);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-blue);
  }

  .pulse-dot-purple {
    width: 6px;
    height: 6px;
    background-color: #9D4EDD;
    border-radius: 50%;
    box-shadow: 0 0 6px #9D4EDD;
  }

  /* INFO COL */
  .vtuber-data-col {
    display: flex;
    flex-direction: column;
  }

  .vtuber-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 0.6rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vtuber-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.4rem;
    margin: 0;
    letter-spacing: 2px;
  }

  .vtuber-handle {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    color: var(--accent-crimson);
    font-weight: 700;
    display: block;
    margin-top: 2px;
  }

  .vt-badges-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .frequency-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid currentColor;
    padding: 2px 6px;
    border-radius: 3px;
  }

  .node-badge {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-blue);
    background: rgba(76, 201, 240, 0.08);
    border: 1px solid rgba(76, 201, 240, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .node-badge:hover {
    background: rgba(76, 201, 240, 0.2);
    box-shadow: 0 0 8px rgba(76, 201, 240, 0.3);
  }

  .vtuber-specs-table {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    border: 1px solid rgba(224, 225, 221, 0.05);
    margin-bottom: 0.8rem;
  }

  .vt-spec-row {
    display: flex;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    gap: 8px;
  }

  .vt-label { font-weight: 700; color: var(--text-secondary); min-width: 140px; letter-spacing: 0.5px; }
  .vt-val { font-weight: 600; color: var(--text-primary); }

  .vtuber-lore-text p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .vtuber-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .vt-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(224, 225, 221, 0.15);
    padding: 0.4rem 0.9rem;
    border-radius: 3px;
    color: var(--text-primary);
    text-decoration: none;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .vt-link-btn:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: rgba(76, 201, 240, 0.1);
  }

  .btn-node {
    border-color: rgba(157, 78, 221, 0.4);
    color: #9D4EDD;
  }
  .btn-node:hover {
    border-color: #9D4EDD;
    color: #fff;
    background: rgba(157, 78, 221, 0.2);
  }

  .btn-dossier {
    border-color: rgba(76, 201, 240, 0.4);
    color: var(--accent-blue);
  }

  /* JOIN CARD */
  .join-network-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px dashed rgba(230, 57, 70, 0.4);
    background: rgba(11, 12, 16, 0.8);
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .join-tag {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-crimson);
    display: block;
    margin-bottom: 0.2rem;
  }

  .join-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.2rem;
    color: var(--text-primary);
    margin: 0 0 0.2rem 0;
    font-weight: 700;
  }

  .join-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  .text-cyan { color: var(--accent-blue); }
  .text-purple { color: #9D4EDD; }

  @media (max-width: 768px) {
    .vtuber-layout { grid-template-columns: 1fr; justify-items: center; text-align: left; }
    .avatar-col { margin-bottom: 0.5rem; }
    .vt-spec-row { flex-direction: column; gap: 2px; }
    .vt-label { min-width: auto; }
    .vtuber-links { justify-content: flex-start; }
    .join-network-card { flex-direction: column; align-items: flex-start; }
  }
</style>