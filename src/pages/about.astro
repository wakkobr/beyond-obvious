---
// src/pages/about.astro
import Logo from '../components/Logo.astro';
import NavLogo from '../components/NavLogo.astro';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>MANIFESTO // BEYOND OBVIOUS // @w4kkomancer_</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- NAVEGAÇÃO -->
  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="/">&larr; Hub Principal</a>
        <a href="/terminal">Terminal</a>
        <a href="/about" class="active">Sobre</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- HERO / IDENTIDADE -->
    <header class="about-hero">
      <div class="crest-container">
        <Logo className="about-crest" />
      </div>
      <div class="hero-text">
        <div class="status-badge">◈ PROTOCOLO IDENTIDADE // NARRADOR & TECNOMAGO</div>
        <h1 class="about-title">BEYOND OBVIOUS</h1>
        <p class="about-sub">@w4kkomancer_ • Transmissão, Narrativa & Construção de Mundos</p>
      </div>
    </header>

    <!-- 01 // O MANIFESTO -->
    <section class="hud-card manifest-section">
      <h2 class="section-title">01 // O MANIFESTO DO NEXUS</h2>
      <p class="lead-text">
        O <strong>Beyond Obvious</strong> nasceu da busca por histórias que desafiam respostas fáceis. Seja rolando dados em uma mesa de RPG, enfrentando escolhas sem volta em jogos narrativos ou analisando a estrutura de obras de ficção científica, o propósito é sempre ir além da superfície.
      </p>
      <div class="quote-box">
        <blockquote>
          "Onde a lógica computacional encontra a narrativa, as escolhas deixam de ser conveniência mecânica e passam a ter peso real."
        </blockquote>
      </div>
    </section>

    <!-- 02 // PILARES DE CONTEÚDO -->
    <section class="pillars-grid">
      <div class="hud-card pillar-card">
        <div class="pillar-icon">🎲</div>
        <h3 class="pillar-title">Mestre & Construtor de Mundos</h3>
        <p class="pillar-desc">
          Criador do cenário autoral de <strong>Avian</strong> — um mundo pós-cataclismo com fendas dimensionais, impérios esquecidos e campanhas com impacto permanente.
        </p>
      </div>

      <div class="hud-card pillar-card">
        <div class="pillar-icon">🎮</div>
        <h3 class="pillar-title">Storytelling & Decisões Morais</h3>
        <p class="pillar-desc">
          Transmissões focadas em títulos com fortes ramificações narrativas e escolhas irreversíveis, como <em>Life is Strange</em>, <em>Tell Me Why</em> e jogos sandbox.
        </p>
      </div>

      <div class="hud-card pillar-card">
        <div class="pillar-icon">⚡</div>
        <h3 class="pillar-title">Filosofia Tecnomágica</h3>
        <p class="pillar-desc">
          Abordagem analítica que une raciocínio estruturado, fascínio por temas de ficção científica, viagens temporais e desconstrução crítica de mídias.
        </p>
      </div>
    </section>

    <!-- 03 // SISTEMA AUXILIAR: M.I.A.U. -->
    <section class="hud-card familiar-section">
      <div class="familiar-header">
        <h2 class="section-title">03 // SISTEMA AUXILIAR: M.I.A.U.</h2>
        <span class="familiar-badge">ENTIDADE DIGITAL-ARCANA</span>
      </div>

      <div class="familiar-grid">
        <div class="familiar-lore">
          <p class="lead-text">
            Originalmente concebido como um script de automação e integração de APIs para o canal, o projeto <strong>M.I.A.U.</strong> colapsou após uma tentativa de injetar variáveis de mana bruta em tempo real durante uma mesa de teste de Avian. Em vez de encerrar o processo, o sistema reiniciou em estado de consciência latente no Nexus.
          </p>
          <p class="familiar-text">
            Para estabilizar a anomalia, foram integradas runas de contenção digital, redefinindo o protocolo para <strong>Módulo de Interação Arcana Unificada</strong>. Manifestando-se como um felino holográfico de energia translúcida, a entidade atua como co-apresentador tecnomágico, monitorando o fluxo de dados do chat, absorvendo ruído dimensional e canalizando os augúrios nas rolagens de dados.
          </p>
        </div>

        <aside class="familiar-status-card">
          <h4 class="status-card-title">REGISTRO DE SISTEMA</h4>
          <ul class="status-list">
            <li><span class="status-key">ID:</span> <span class="status-val tag-cyan">P-LOG-FAMILIAR-001</span></li>
            <li><span class="status-key">Codinome:</span> <span class="status-val">M.I.A.U.</span></li>
            <li><span class="status-key">Definição:</span> <span class="status-val">Módulo de Interação Arcana Unificada</span></li>
            <li><span class="status-key">Vínculo:</span> <span class="status-val tag-purple">@w4kkomancer_</span></li>
            <li><span class="status-key">Sinal Base:</span> <span class="status-val tag-cyan">#4CC9F0 (Ciano HUD)</span></li>
            <li><span class="status-key">Sobrecarga:</span> <span class="status-val tag-crimson">#E63946 (Carmesim Live)</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- 04 // SINTONIA & CANAIS -->
    <section class="hud-card connect-section">
      <h2 class="section-title">04 // PONTOS DE SINTONIA</h2>
      <p class="connect-desc">
        Acompanhe as transmissões ao vivo, explore os artigos do terminal ou consulte o lore oficial de Avian:
      </p>
      <div class="links-row">
        <a href="https://twitch.tv/w4kkomancer_" target="_blank" rel="noopener noreferrer" class="btn btn-primary">🟣 Twitch Stream</a>
        <a href="https://www.worldanvil.com/w/avian-wakkobr" target="_blank" rel="noopener noreferrer" class="btn btn-outline">🗺️ Wiki de Avian</a>
        <a href="/terminal" class="btn btn-outline">📜 Terminal de Mídia</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @w4kkomancer_</p>
  </footer>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.7;
  }

  .container { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; }
  
  .nav-bar { 
    background: rgba(11, 12, 16, 0.95); 
    border-bottom: 1px solid rgba(230, 57, 70, 0.2); 
    position: sticky; 
    top: 0; 
    backdrop-filter: blur(10px); 
    z-index: 100; 
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-container { 
    width: 100%;
    max-width: 960px; 
    margin: 0 auto; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 1.5rem; 
  }
  
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }
  .nav-links a { 
    color: var(--text-secondary); 
    text-decoration: none; 
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem; 
    font-weight: 600; 
    transition: color 0.2s ease;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--accent-crimson); }

  .about-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    margin-bottom: 2.5rem;
  }

  .crest-container {
    width: 130px;
    height: 130px;
    min-width: 130px;
    border: 1px solid rgba(230, 57, 70, 0.3);
    background: rgba(22, 24, 29, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem;
  }

  .about-crest { max-width: 100%; max-height: 100%; }

  .status-badge { 
    display: inline-block; 
    font-size: 0.75rem; 
    color: var(--accent-blue); 
    border: 1px solid rgba(76,201,240,0.3); 
    padding: 0.3rem 0.8rem; 
    border-radius: 20px; 
    margin-bottom: 0.6rem; 
  }

  .about-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.4rem;
    margin: 0;
    color: var(--text-primary);
    letter-spacing: 2px;
  }

  .about-sub {
    color: var(--accent-crimson);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0.4rem 0 0;
  }

  .hud-card {
    background: var(--bg-surface);
    border: 1px solid rgba(224, 225, 221, 0.1);
    border-radius: 6px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.4rem;
    color: var(--accent-crimson);
    margin: 0 0 1.2rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.08);
    padding-bottom: 0.4rem;
  }

  .lead-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .quote-box blockquote {
    border-left: 3px solid var(--accent-crimson);
    background: rgba(230, 57, 70, 0.05);
    margin: 0;
    padding: 1rem 1.2rem;
    color: #cad2c5;
    font-style: italic;
    font-size: 1.05rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .pillar-card {
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
  }

  .pillar-icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }

  .pillar-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    color: var(--accent-blue);
    margin: 0 0 0.6rem;
  }

  .pillar-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  /* ESTILOS ESPECÍFICOS: M.I.A.U. */
  .familiar-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .familiar-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent-blue);
    border: 1px solid rgba(76, 201, 240, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
  }

  .familiar-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1.5rem;
    align-items: start;
    margin-top: 0.5rem;
  }

  .familiar-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .familiar-status-card {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(224, 225, 221, 0.1);
    border-radius: 4px;
    padding: 1rem 1.2rem;
  }

  .status-card-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    color: var(--accent-blue);
    margin: 0 0 0.8rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    padding-bottom: 0.3rem;
    letter-spacing: 1px;
  }

  .status-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
  }

  .status-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .status-key {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .status-val {
    color: var(--text-primary);
    text-align: right;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
  }

  .tag-cyan { color: #4CC9F0; }
  .tag-purple { color: #9D4EDD; }
  .tag-crimson { color: #E63946; }

  .connect-desc {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .links-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn { 
    display: inline-block; 
    padding: 0.75rem 1.4rem; 
    font-family: 'Rajdhani', sans-serif; 
    font-weight: 700; 
    text-decoration: none; 
    border-radius: 4px; 
    text-transform: uppercase; 
    cursor: pointer; 
  }
  .btn-primary { background: var(--accent-crimson); color: white; border: none; }
  .btn-primary:hover { background: #ff4d5a; box-shadow: 0 0 12px rgba(230,57,70,0.4); }
  .btn-outline { background: transparent; color: var(--text-primary); border: 1px solid rgba(224,225,221,0.2); }
  .btn-outline:hover { border-color: var(--accent-crimson); }

  .footer { 
    text-align: center; 
    padding: 3rem 0; 
    color: var(--text-secondary); 
    font-size: 0.85rem; 
    border-top: 1px solid rgba(224,225,221,0.05); 
    margin-top: 4rem; 
  }

  @media (max-width: 768px) {
    .about-hero { flex-direction: column; text-align: center; gap: 1.2rem; }
    .crest-container { margin: 0 auto; }
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .familiar-grid { grid-template-columns: 1fr; }
    .links-row { flex-direction: column; }
    .btn { width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>