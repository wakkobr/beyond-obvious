---
// src/pages/about.astro
import Logo from '../components/Logo.astro';
import NavLogo from '../components/NavLogo.astro';
// Importa o conteúdo da lore do familiar em português
import { Content as MiauLorePt } from '../components/MiauLore.md';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>MANIFESTO // BEYOND OBVIOUS // @w4kkomancer_</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- NAVEGAÇÃO -->
  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="/#stream">Transmissões</a>
        <a href="/terminal">Terminal</a>
        <a href="/about" class="active">Sobre</a>
        <a href="/#signal">Sinal</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- HERO DA PÁGINA SOBRE -->
    <header class="about-hero">
      <Logo className="about-crest" />
      <h1 class="about-title">BEYOND OBVIOUS</h1>
      <p class="about-sub">@w4kkomancer_ • Transmissão, Narrativa & Construção de Mundos</p>
    </header>

    <!-- CONTEÚDO PRINCIPAL (MANIFESTO) -->
    <section class="manifesto-section">
      <div class="hud-card manifesto-card">
        <div class="card-header">
          <span class="badg-blue">PROTOCOLO: MANIFESTO</span>
          <span class="mono-text">VER: 1.0</span>
        </div>
        
        <h2 class="card-title-lg">Sintonizando o Nexus</h2>
        
        <div class="manifesto-content">
          <p>Seja bem-vindo ao <strong>Beyond Obvious</strong>. Este não é apenas um canal de transmissões; é um Nexus, um ponto de convergência onde a lógica fria da tecnologia encontra o calor indomável das narrativas.</p>
          
          <p>Eu sou <strong>@w4kkomancer_</strong>, seu Tecnomago e Narrador. Minha missão é explorar as fronteiras da ficção especulativa, desconstruir mecânicas de jogos e, acima de tudo, criar mundos imersivos através do RPG de Mesa.</p>

          <p>Acreditamos que as melhores histórias são aquelas que nos desafiam a olhar além da superfície. Se você busca análises superficiais ou gameplays genéricas, este talvez não seja o seu lugar. Aqui, nós mergulhamos fundo no <em>lore</em>, discutimos design e abraçamos o mistério.</p>
        </div>
      </div>
    </section>

    <!-- SEÇÃO: O FAMILIAR TECNOMÁGICO (M.I.A.U.) -->
    <section id="familiar" class="familiar-section section">
      <h2 class="section-title">01 // SISTEMA AUXILIAR: M.I.A.U.</h2>
      
      <div class="familiar-grid">
        <div class="familiar-lore-container hud-card">
          <div class="card-meta mb-3">
            <span class="badg-blue">ARQUIVO_LORE.LOG</span>
            <span class="mono-text cat-nexus">SINTONIA OK</span>
          </div>
          <div class="markdown-content card-desc">
            <!-- Renderiza o conteúdo do arquivo Markdown em português -->
            <MiauLorePt />
          </div>
        </div>
        
        <!-- Sidebar do Familiar com Dados Técnicos em Português -->
        <aside class="familiar-sidebar hud-card">
          <h3 class="card-title">Status da Entidade</h3>
          <ul class="status-list">
            <li><span class="label">ID:</span> <span class="value cat-nexus">P-LOG-FAMILIAR-001</span></li>
            <li><span class="label">Codinome:</span> <span class="value">M.I.A.U.</span></li>
            <li><span class="label">Definição:</span> <span class="value">Módulo de Interação Arcana Unificada</span></li>
            <li><span class="label">Vínculo:</span> <span class="value cat-rpg">@w4kkomancer_</span></li>
            <li><span class="label">Cor Primária:</span> <span class="value cat-avian">#4CC9F0 (Ciano HUD)</span></li>
            <li><span class="label">Cor Crítica:</span> <span class="value cat-gaming">#E63946 (Carmesim Live)</span></li>
          </ul>
          <div class="energy-bar mt-3">
            <div class="bar-fill" style="width: 85%"></div>
            <span class="bar-label mono-text">NÍVEL DE SINTONIA: 85%</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- SEÇÃO DE FOCO -->
    <section class="section">
      <h2 class="section-title">02 // PILARES DA TRANSMISSÃO</h2>
      <div class="posts-grid">
        <div class="hud-card pillar-card">
          <span class="pillar-icon">🎲</span>
          <h3 class="card-title">RPG & Worldbuilding</h3>
          <p class="card-desc">Sessões ao vivo em Avian, discussões de regras, design de cenários e campanhas autorais.</p>
        </div>
        <div class="hud-card pillar-card">
          <span class="pillar-icon">🎮</span>
          <h3 class="card-title">Narrative Gaming</h3>
          <p class="card-desc">Foco em jogos com histórias fortes, Life is Strange, desconstrução de roteiros e Indies.</p>
        </div>
        <div class="hud-card pillar-card">
          <span class="pillar-icon">💬</span>
          <h3 class="card-title">Sci-Fi & Debates</h3>
          <p class="card-desc">Tecnologia, mistério e Just Chatting sobre o futuro e as fronteiras da ficção.</p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="section text-center">
      <div class="hud-card">
        <h2 class="card-title">Pronto para ir além?</h2>
        <p class="card-desc mb-4">Acompanhe as frequências ao vivo na Twitch.</p>
        <a href="https://twitch.tv/w4kkomancer_" target="_blank" rel="noopener noreferrer" class="btn btn-primary">🟣 Twitch Stream</a>
      </div>
    </section>
  </main>

  <!-- RODAPÉ -->
  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @w4kkomancer_</p>
  </footer>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
  .text-center { text-align: center; }
  
  .nav-bar { background: rgba(11, 12, 16, 0.95); border-bottom: 1px solid rgba(230, 57, 70, 0.2); position: sticky; top: 0; backdrop-filter: blur(10px); z-index: 100; height: 70px; display: flex; align-items: center;}
  .nav-container { width: 100%; max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; }
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }
  .nav-links a { color: var(--text-secondary); text-decoration: none; font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 600; }
  .nav-links a:hover, .nav-links a.active { color: var(--accent-crimson); }

  .about-hero { text-align: center; padding: 4rem 0 3rem; }
  .about-crest { max-width: 120px; margin: 0 auto 1.5rem; }
  .about-title { font-family: 'Orbitron', sans-serif; font-size: 2.5rem; margin: 0; color: var(--text-primary); letter-spacing: 2px; }
  .about-sub { color: var(--accent-crimson); font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; margin: 0.5rem 0 0; }

  .manifesto-card { padding: 2rem; border-color: rgba(76, 201, 240, 0.2); box-shadow: 0 0 15px rgba(76, 201, 240, 0.1); }
  .card-header { display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.8rem; color: var(--text-secondary); }
  .badg-blue { color: var(--accent-blue); border: 1px solid rgba(76,201,240,0.3); padding: 0.2rem 0.6rem; border-radius: 4px; }
  .card-title-lg { font-family: 'Rajdhani', sans-serif; font-size: 1.8rem; margin: 0 0 1rem; color: var(--text-primary); }
  .manifesto-content p { margin: 0 0 1rem; color: var(--text-secondary); }

  .section { padding: 3rem 0 1rem; }
  .section-title { font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; color: var(--accent-crimson); margin: 0 0 1.5rem; }
  
  .familiar-grid { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; align-items: flex-start; }
  .familiar-lore-container { padding: 2rem; }
  
  .familiar-sidebar { padding: 1.5rem; border-color: rgba(230, 57, 70, 0.2); position: sticky; top: 90px; }
  .familiar-sidebar .card-title { font-size: 1.1rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(224,225,221,0.1); padding-bottom: 0.5rem;}
  .status-list { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
  .status-list li { display: flex; justify-content: space-between; margin-bottom: 0.6rem; padding-bottom: 0.3rem; border-bottom: 1px solid rgba(0,0,0,0.2); gap: 1rem; }
  .status-list .label { color: var(--text-secondary); font-weight: 600; white-space: nowrap; }
  .status-list .value { color: var(--text-primary); text-align: right; font-family: 'Rajdhani', sans-serif; font-weight: 600;}

  .cat-avian { color: #4CC9F0; }
  .cat-rpg { color: #9D4EDD; }
  .cat-nexus { color: #2A9D8F; }
  .cat-gaming { color: #E63946; }

  .energy-bar { background: rgba(0,0,0,0.3); border: 1px solid rgba(224,225,221,0.1); border-radius: 4px; height: 35px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .bar-fill { background: var(--accent-blue); height: 100%; position: absolute; top: 0; left: 0; box-shadow: 0 0 10px rgba(76, 201, 240, 0.5); }
  .bar-label { position: relative; z-index: 1; font-size: 0.75rem; color: var(--text-primary); font-weight: bold; }

  .hud-card { background: var(--bg-surface); border: 1px solid rgba(224,225,221,0.1); border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .hud-card:hover { border-color: rgba(230, 57, 70, 0.5); }
  .card-title { font-family: 'Rajdhani', sans-serif; font-size: 1.3rem; margin: 0 0 0.5rem; color: var(--text-primary); }
  .card-desc { color: var(--text-secondary); margin: 0; font-size: 0.95rem; }
  .pillar-card { text-align: center; padding: 2rem; }
  .pillar-icon { font-size: 2.5rem; display: block; margin-bottom: 1rem; }

  .btn { display: inline-block; padding: 0.75rem 1.5rem; font-family: 'Rajdhani', sans-serif; font-weight: 700; text-decoration: none; border-radius: 4px; text-transform: uppercase; cursor: pointer; border: none;}
  .btn-primary { background: var(--accent-crimson); color: white; }
  .btn-primary:hover { background: #ff4d5a; box-shadow: 0 0 12px rgba(230,57,70,0.4); }
  
  .footer { text-align: center; padding: 3rem 0; color: var(--text-secondary); font-size: 0.85rem; border-top: 1px solid rgba(224,225,221,0.05); margin-top: 4rem; }
  .mono-text { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; }
  .mt-3 { margin-top: 1rem; }
  .mb-3 { margin-bottom: 1rem; }
  .mb-4 { margin-bottom: 1.5rem; }

  /* Markdown Content Styling */
  .markdown-content p { margin: 0 0 1rem; }
  .markdown-content p:last-child { margin-bottom: 0; }
  .markdown-content strong { color: var(--text-primary); font-weight: 600; }

  @media (max-width: 900px) {
    .familiar-grid { grid-template-columns: 1fr; }
    .familiar-sidebar { position: static; width: auto; }
  }

  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .hero-split { grid-template-columns: 1fr; text-align: center; gap: 1.5rem; padding: 2rem 0; }
    .about-crest { max-width: 80px; }
    .about-title { font-size: 2rem; }
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>