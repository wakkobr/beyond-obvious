---
// src/pages/vault.astro
import NavLogo from '../components/NavLogo.astro';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>COFRE ARCANO // BEYOND OBVIOUS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- NAVEGAÇÃO -->
  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="/" data-pt="&larr; Hub Principal" data-en="&larr; Main Hub">&larr; Hub Principal</a>
        <a href="#cosmology" data-pt="Cosmologia" data-en="Cosmology">Cosmologia</a>
        <a href="#factions" data-pt="Facções" data-en="Factions">Facções</a>
        <a href="#logs" data-pt="Diários" data-en="Logs">Diários</a>
        <button id="lang-toggle" class="lang-btn">EN</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- HEADER DA SUB-PÁGINA -->
    <header class="vault-header">
      <div class="status-badge">◈ ARQUIVO CENTRAL // PROTOCOLO DE LORE</div>
      <h1 class="vault-title">O COFRE ARCANO</h1>
      <p class="vault-sub" data-pt="Repositório de Construção de Mundos, Cosmologia e Crônicas de Mesa" data-en="Worldbuilding Repository, Cosmology & Tabletop Chronicles">
        Repositório de Construção de Mundos, Cosmologia e Crônicas de Mesa
      </p>
      <div class="external-cta">
        <a href="https://www.worldanvil.com/w/avian-wakkobr" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-pt="🌐 Acessar Wiki Completa (Avian) no World Anvil &rarr;" data-en="🌐 Open Full Avian Wiki on World Anvil &rarr;">
          🌐 Acessar Wiki Completa (Avian) no World Anvil &rarr;
        </a>
      </div>
    </header>

    <!-- 01 // COSMOLOGIA & MUNDO -->
    <section id="cosmology" class="section">
      <h2 class="section-title">01 // <span data-pt="COSMOLOGIA & SISTEMA ARCANO" data-en="COSMOLOGY & ARCANE SYSTEM">COSMOLOGIA & SISTEMA ARCANO</span></h2>
      <div class="hud-card">
        <h3 class="card-title" data-pt="A Trama & A Lógica Arcana" data-en="The Weave & Arcane Logic">A Trama & A Lógica Arcana</h3>
        <p class="card-desc" data-pt="Um cenário onde a magia não é caótica por acaso, mas um sistema intrincado de regras, padrões e energias primordiais que podem ser compreendidos, modulados e desafiados." data-en="A setting where magic isn't mere chaos, but an intricate framework of principles and primordial currents waiting to be decoded.">
          Um cenário onde a magia não é caótica por acaso, mas um sistema intrincado de regras, padrões e energias primordiais que podem ser compreendidos, modulados e desafiados.
        </p>
        <div class="lore-pills">
          <div class="pill">
            <span class="pill-title" data-pt="Planos & Dimensões" data-en="Planes & Spheres">Planos & Dimensões</span>
            <span class="pill-detail" data-pt="Camadas sobrepostas conectadas por nexos de energia." data-en="Overlapping layers interconnected by energy nexuses.">Camadas sobrepostas conectadas por nexos de energia.</span>
          </div>
          <div class="pill">
            <span class="pill-title" data-pt="Tecnomagia" data-en="Technomancy">Tecnomagia</span>
            <span class="pill-detail" data-pt="Fusão de circuitos lógicos, glifos rúnicos e matéria arcana." data-en="Fusion of logical circuitry, runic glyphs, and arcane matter.">Fusão de circuitos lógicos, glifos rúnicos e matéria arcana.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 // FACÇÕES & FORÇAS -->
    <section id="factions" class="section">
      <h2 class="section-title">02 // <span data-pt="FACÇÕES & PODERES EM JOGO" data-en="FACTIONS & POWERS AT PLAY">FACÇÕES & PODERES EM JOGO</span></h2>
      <div class="grid-2">
        <div class="hud-card">
          <span class="category-tag">ORDEM PRIMORDIAL</span>
          <h3 class="card-title" data-pt="A Cátedra dos Tecnomagos" data-en="The Technomancer Athenaeum">A Cátedra dos Tecnomagos</h3>
          <p class="card-desc" data-pt="Eruditos e artífices dedicados a catalogar as leis ocultas da realidade e convertê-las em engenharia aplicável." data-en="Scholars and artificers dedicated to cataloging the hidden laws of reality into applied engineering.">
            Eruditos e artífices dedicados a catalogar as leis ocultas da realidade e convertê-las em engenharia aplicável.
          </p>
        </div>
        <div class="hud-card">
          <span class="category-tag">ENTROPIA</span>
          <h3 class="card-title" data-pt="Os Ecos do Vazio" data-en="Echoes of the Void">Os Ecos do Vazio</h3>
          <p class="card-desc" data-pt="Cultos e anomalias que buscam desfazer a malha da realidade e reivindicar o poder que reside além dos limites conhecidos." data-en="Cults and anomalies seeking to unravel the fabric of reality and claim dominion over the unknown.">
            Cultos e anomalias que buscam desfazer a malha da realidade e reivindicar o poder que reside além dos limites conhecidos.
          </p>
        </div>
      </div>
    </section>

    <!-- 03 // DIÁRIOS DE CAMPANHA & REGRAS -->
    <section id="logs" class="section">
      <h2 class="section-title">03 // <span data-pt="CRÔNICAS DE MESA & DIRETRIZES" data-en="TABLETOP LOGS & GUIDELINES">CRÔNICAS DE MESA & DIRETRIZES</span></h2>
      <div class="hud-card">
        <h3 class="card-title" data-pt="Diretrizes de Jogo & Regras da Casa" data-en="Table Rules & House Systems">Diretrizes de Jogo & Regras da Casa</h3>
        <p class="card-desc mb-3" data-pt="Nossas campanhas priorizam escolhas de peso, consequências permanentes no mundo e desenvolvimento narrativo orgânico." data-en="Our campaigns emphasize impactful choices, lasting consequences, and narrative-first progression.">
          Nossas campanhas priorizam escolhas de peso, consequências permanentes no mundo e desenvolvimento narrativo orgânico.
        </p>
        <div class="terminal-box">
          <code>[STATUS]: Sessões ativas documentadas no World Anvil (Avian)</code><br/>
          <code>[PROTOCOL]: 100% de integração com mapas interativos e fichas de NPCs</code>
        </div>
      </div>
    </section>
  </main>

  <!-- RODAPÉ -->
  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @W4KKO_</p>
  </footer>

  <!-- SCRIPT ALTERNADOR IDIOMA -->
  <script>
    const toggleBtn = document.getElementById('lang-toggle');
    let currentLang = 'pt';

    toggleBtn?.addEventListener('click', () => {
      currentLang = currentLang === 'pt' ? 'en' : 'pt';
      toggleBtn.textContent = currentLang === 'pt' ? 'EN' : 'PT';

      document.querySelectorAll('[data-pt]').forEach(el => {
        const target = el as HTMLElement;
        target.textContent = currentLang === 'pt' ? target.dataset.pt! : target.dataset.en!;
      });
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
  
  .nav-bar { 
    background: rgba(11, 12, 16, 0.95); 
    border-bottom: 1px solid rgba(230, 57, 70, 0.2); 
    position: sticky; 
    top: 0; 
    backdrop-filter: blur(10px); 
    z-index: 100; 
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-container { 
    width: 100%;
    max-width: 960px; 
    margin: 0 auto; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 1.5rem; 
  }
  
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }
  .nav-links a { 
    color: var(--text-secondary); 
    text-decoration: none; 
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem; 
    font-weight: 600; 
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--accent-crimson); }

  .lang-btn { 
    background: transparent; 
    border: 1px solid var(--accent-blue); 
    color: var(--accent-blue); 
    padding: 0.2rem 0.6rem; 
    border-radius: 4px; 
    cursor: pointer; 
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700; 
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .lang-btn:hover { background: rgba(76, 201, 240, 0.15); box-shadow: 0 0 8px rgba(76, 201, 240, 0.4); }

  .vault-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid rgba(224, 225, 221, 0.1);
    margin-bottom: 2rem;
  }

  .status-badge { 
    display: inline-block; 
    font-size: 0.75rem; 
    color: var(--accent-blue); 
    border: 1px solid rgba(76,201,240,0.3); 
    padding: 0.3rem 0.8rem; 
    border-radius: 20px; 
    margin-bottom: 0.8rem; 
  }

  .vault-title { 
    font-family: 'Orbitron', sans-serif; 
    font-size: 2.6rem; 
    margin: 0; 
    color: var(--text-primary); 
    letter-spacing: 2px; 
  }

  .vault-sub { 
    color: var(--text-secondary); 
    font-size: 1.1rem; 
    margin: 0.6rem 0 1.5rem; 
  }

  .btn { 
    display: inline-block; 
    padding: 0.75rem 1.5rem; 
    font-family: 'Rajdhani', sans-serif; 
    font-weight: 700; 
    text-decoration: none; 
    border-radius: 4px; 
    text-transform: uppercase; 
    cursor: pointer; 
  }
  .btn-primary { background: var(--accent-crimson); color: white; border: none; }
  .btn-primary:hover { background: #ff4d5a; box-shadow: 0 0 12px rgba(230,57,70,0.4); }

  .section { padding: 2rem 0 1rem; }
  .section-title { 
    font-family: 'Rajdhani', sans-serif; 
    font-size: 1.4rem; 
    color: var(--accent-crimson); 
    border-bottom: 1px solid rgba(224,225,221,0.1); 
    padding-bottom: 0.4rem; 
    margin-bottom: 1.2rem; 
  }

  .hud-card { 
    background: var(--bg-surface); 
    border: 1px solid rgba(224,225,221,0.1); 
    border-radius: 6px; 
    padding: 1.5rem; 
    transition: border-color 0.2s ease;
  }
  .hud-card:hover { border-color: rgba(230,57,70,0.5); }

  .card-title { font-family: 'Rajdhani', sans-serif; font-size: 1.3rem; margin: 0.3rem 0 0.5rem; color: var(--text-primary); }
  .card-desc { color: var(--text-secondary); margin: 0; font-size: 0.95rem; }
  .category-tag { color: var(--accent-blue); font-size: 0.8rem; font-weight: 700; }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.2rem;
  }

  .lore-pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .pill {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(224, 225, 221, 0.08);
    padding: 0.8rem 1rem;
    border-radius: 4px;
  }

  .pill-title {
    display: block;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    color: var(--accent-blue);
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .pill-detail {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .terminal-box {
    background: #060709;
    border-left: 3px solid var(--accent-crimson);
    padding: 0.8rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: #4CC9F0;
    border-radius: 0 4px 4px 0;
  }

  .footer { 
    text-align: center; 
    padding: 3rem 0; 
    color: var(--text-secondary); 
    font-size: 0.85rem; 
    border-top: 1px solid rgba(224,225,221,0.05); 
    margin-top: 4rem; 
  }

  .mb-3 { margin-bottom: 1rem; }

  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .vault-title { font-size: 2rem; }
  }
</style>