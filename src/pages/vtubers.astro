---
// src/pages/vtubers.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import I18nScript from '../components/I18nScript.astro';

// Lista de VTubers / Operadores do Hub
const vtubers = [
  {
    name: "w4kkomancer_",
    handle: "@w4kkomancer_",
    rolePt: "Guardião do Nexus & Tecnomago",
    roleEn: "Nexus Warden & Technomancer",
    specialtyPt: "Storytelling, Deckmancia & RPG de Mesa",
    specialtyEn: "Storytelling, Deckmancy & Tabletop RPG",
    originNodePt: "Terminal Central // Beyond Obvious",
    originNodeEn: "Core Terminal // Beyond Obvious",
    nodeUrl: "https://beyond-obvious.net",
    avatar: "/images/w4kko-avatar.png",
    accentColor: "cyan",
    twitch: "https://twitch.tv/w4kkomancer_",
    youtube: "https://www.youtube.com/channel/UCqw0c6fhpxKFAb-eDPHDKew",
    x: "https://x.com/w4kkomancer_",
    dossier: "/dossier"
  },
  {
    name: "DeniLunae",
    handle: "@DeniLunae",
    rolePt: "Operadora de Sinal // Guardiã Lunar",
    roleEn: "Signal Operator // Lunar Guardian",
    specialtyPt: "Gaming, Variedades & Transmissões Noturnas",
    specialtyEn: "Gaming, Variety & Night Broadcasts",
    originNodePt: "Santuário // Moonhaven",
    originNodeEn: "Sanctuary // Moonhaven",
    nodeUrl: "https://moonhaven.beyond-obvious.net",
    avatar: "/images/denilunae-avatar.png",
    accentColor: "purple",
    twitch: "https://twitch.tv",
    youtube: "",
    x: "",
    dossier: ""
  }
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>VTUBERS // REDE DE OPERADORES - BEYOND OBVIOUS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- HEADER MODULAR -->
  <Header currentPage="vtubers" />

  <main class="container">
    
    <!-- CABEÇALHO DA PÁGINA -->
    <header class="page-header">
      <div class="status-badge" data-pt="◈ DIRETÓRIO DE SINAIS // REDE DESCENTRALIZADA DE VTUBERS" data-en="◈ SIGNAL DIRECTORY // DECENTRALIZED VTUBER NETWORK">
        ◈ DIRETÓRIO DE SINAIS // REDE DESCENTRALIZADA DE VTUBERS
      </div>
      <h1 class="page-title">VTUBERS // OPERADORES</h1>
      <p class="page-sub" data-pt="FREQUÊNCIAS ATIVAS & SANTUÁRIOS VINCULADOS AO NEXUS" data-en="ACTIVE FREQUENCIES & SANCTUARIES LINKED TO THE NEXUS">FREQUÊNCIAS ATIVAS & SANTUÁRIOS VINCULADOS AO NEXUS</p>
    </header>

    <!-- INTRODUÇÃO DA SEÇÃO -->
    <section class="section">
      <div class="hud-card">
        <p data-pt="O Beyond Obvious opera como um repetidor e amplificador de sinal para avatares virtuais e VTubers independentes. Cada operador conectado à malha comanda sua própria estação de transmissão e seu próprio santuário de conteúdo." data-en="Beyond Obvious operates as a signal relay and amplifier for virtual avatars and independent VTubers. Each operator synced to the matrix commands their own broadcast relay and sanctuary of content.">
          O Beyond Obvious opera como um repetidor e amplificador de sinal para avatares virtuais e VTubers independentes. Cada operador conectado à malha comanda sua própria estação de transmissão e seu próprio santuário de conteúdo.
        </p>
      </div>
    </section>

    <!-- GRADE DE VTUBERS -->
    <section class="section">
      <div class="vtubers-grid">
        {vtubers.map((vt) => (
          <div class={`hud-card vtuber-card border-${vt.accentColor}`}>
            <div class="crest-corner top-left"></div>
            <div class="crest-corner top-right"></div>
            <div class="crest-corner bottom-left"></div>
            <div class="crest-corner bottom-right"></div>

            <div class="vtuber-layout">
              <!-- AVATAR BOX -->
              <div class="avatar-box">
                <div class={`avatar-frame avatar-border-${vt.accentColor}`}>
                  {vt.avatar ? (
                    <img 
                      src={vt.avatar} 
                      alt={vt.name} 
                      class="avatar-img" 
                      loading="lazy"
                    />
                  ) : (
                    <div class="avatar-placeholder">
                      <span class="ph-glyph">◈</span>
                      <span class="ph-name">{vt.name}</span>
                      <span class="ph-note">SINAL VIRTUAL</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- INFO DO VTUBER -->
              <div class="vtuber-info">
                <div class="vtuber-header-row">
                  <div>
                    <h3 class="vtuber-name">{vt.name}</h3>
                    <span class="vtuber-handle">{vt.handle}</span>
                  </div>
                  {vt.nodeUrl && (
                    <a href={vt.nodeUrl} target="_blank" rel="noopener noreferrer" class="node-badge" title="Acessar Domínio do Operador">
                      🌐 <span data-pt={vt.originNodePt} data-en={vt.originNodeEn}>{vt.originNodePt}</span> &rarr;
                    </a>
                  )}
                </div>

                <div class="vtuber-tags-table">
                  <div class="vt-spec-row">
                    <span class="vt-label" data-pt="MATRIZ / PAPEL:" data-en="MATRIX / ROLE:">MATRIZ / PAPEL:</span>
                    <span class="vt-val" data-pt={vt.rolePt} data-en={vt.roleEn}>{vt.rolePt}</span>
                  </div>
                  <div class="vt-spec-row">
                    <span class="vt-label" data-pt="ESPECIALIDADE:" data-en="SPECIALTY:">ESPECIALIDADE:</span>
                    <span class="vt-val text-dim" data-pt={vt.specialtyPt} data-en={vt.specialtyEn}>{vt.specialtyPt}</span>
                  </div>
                </div>

                <!-- LINKS DO VTUBER -->
                <div class="vtuber-links">
                  {vt.nodeUrl && (
                    <a href={vt.nodeUrl} target="_blank" rel="noopener noreferrer" class="vt-link-btn btn-node" data-pt="🌌 Santuário" data-en="🌌 Sanctuary">
                      🌌 Santuário
                    </a>
                  )}
                  {vt.twitch && (
                    <a href={vt.twitch} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="Twitch">
                      🟣 Twitch
                    </a>
                  )}
                  {vt.youtube && (
                    <a href={vt.youtube} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="YouTube">
                      🔴 YouTube
                    </a>
                  )}
                  {vt.x && (
                    <a href={vt.x} target="_blank" rel="noopener noreferrer" class="vt-link-btn" title="X (Twitter)">
                      ✖️ X
                    </a>
                  )}
                  {vt.dossier && (
                    <a href={vt.dossier} class="vt-link-btn btn-dossier" data-pt="📁 Dossiê" data-en="📁 Dossier">
                      📁 Dossiê
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CARD DE CONVITE // ESTABELECER VÍNCULO -->
    <section class="section">
      <div class="hud-card join-network-card">
        <div class="join-info">
          <span class="join-tag" data-pt="EXPANSÃO DE MALHA" data-en="NETWORK EXPANSION">EXPANSÃO DE MALHA</span>
          <h3 class="join-title" data-pt="É um VTuber ou Criador Virtual?" data-en="Are you a VTuber or Virtual Creator?">É um VTuber ou Criador Virtual?</h3>
          <p class="join-desc" data-pt="Conecte seu canal ao hub Beyond Obvious para integrar collabs, subdomínios dedicados e campanhas compartilhadas." data-en="Link your channel to the Beyond Obvious hub to participate in collabs, dedicated subdomains, and shared campaigns.">
            Conecte seu canal ao hub Beyond Obvious para integrar collabs, subdomínios dedicados e campanhas compartilhadas.
          </p>
        </div>
        <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-pt="⚡ SINCRONIZAR SINAL" data-en="⚡ SYNC SIGNAL">
          ⚡ SINCRONIZAR SINAL
        </a>
      </div>
    </section>

  </main>

  <!-- FOOTER MODULAR -->
  <Footer />

  <!-- SCRIPT GLOBAL DE TRADUÇÃO -->
  <I18nScript />

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --accent-purple: #9D4EDD;
    --accent-pink: #F72585;
    --accent-gold: #F4A261;
    --accent-green: #2A9D8F;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body {
    margin: 0;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }

  /* CABEÇALHO */
  .page-header {
    padding: 3rem 0 1.5rem;
  }

  .status-badge { 
    display: inline-block; 
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.8rem; 
    letter-spacing: 1.5px;
    color: var(--accent-blue); 
    border: 1px solid rgba(76, 201, 240, 0.3); 
    padding: 0.3rem 0.8rem; 
    border-radius: 20px; 
    margin-bottom: 0.8rem; 
  }

  .page-title { 
    font-family: 'Orbitron', sans-serif; 
    font-size: 2.3rem; 
    margin: 0; 
    color: var(--text-primary); 
    letter-spacing: 2px; 
    line-height: 1.1; 
  }

  .page-sub { 
    color: var(--accent-crimson); 
    font-family: 'Rajdhani', sans-serif; 
    font-size: 1.15rem; 
    font-weight: 700; 
    margin: 0.4rem 0 0; 
    letter-spacing: 2px;
  }

  /* SEÇÕES & CARDS */
  .section { padding: 1rem 0 0.5rem; }

  .hud-card { 
    background: var(--bg-surface); 
    border: 1px solid rgba(224, 225, 221, 0.1); 
    border-radius: 6px; 
    padding: 1.5rem; 
    position: relative;
  }

  /* VTUBERS GRID */
  .vtubers-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .vtuber-card {
    background: rgba(22, 24, 29, 0.9);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .vtuber-card:hover {
    transform: translateY(-2px);
  }

  .border-cyan { border-color: rgba(76, 201, 240, 0.3); }
  .border-cyan:hover { border-color: var(--accent-blue); box-shadow: 0 0 16px rgba(76, 201, 240, 0.15); }
  
  .border-purple { border-color: rgba(157, 78, 221, 0.3); }
  .border-purple:hover { border-color: var(--accent-purple); box-shadow: 0 0 16px rgba(157, 78, 221, 0.15); }

  .crest-corner {
    position: absolute;
    width: 8px;
    height: 8px;
  }
  .crest-corner.top-left { top: -1px; left: -1px; border-top: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.top-right { top: -1px; right: -1px; border-top: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-left { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-right { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }

  .vtuber-layout {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  /* AVATAR BOX */
  .avatar-box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .avatar-frame {
    width: 130px;
    height: 130px;
    background: #0B0C10;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .avatar-border-cyan { 
    border: 2px solid rgba(76, 201, 240, 0.4); 
    box-shadow: inset 0 0 12px rgba(76, 201, 240, 0.15);
  }
  .avatar-border-purple { 
    border: 2px solid rgba(157, 78, 221, 0.4); 
    box-shadow: inset 0 0 12px rgba(157, 78, 221, 0.15);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.3s ease;
  }

  .vtuber-card:hover .avatar-img {
    transform: scale(1.05);
  }

  .avatar-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem;
  }

  .ph-glyph { font-size: 1.5rem; color: var(--accent-blue); }
  .ph-name { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.8rem; color: var(--text-primary); }
  .ph-note { font-size: 0.65rem; color: var(--text-secondary); font-family: 'JetBrains Mono', monospace; }

  /* INFO */
  .vtuber-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .vtuber-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vtuber-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.3rem;
    margin: 0;
    letter-spacing: 1px;
    color: var(--text-primary);
  }

  .vtuber-handle {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    color: var(--accent-crimson);
    font-weight: 700;
  }

  .node-badge {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-blue);
    background: rgba(76, 201, 240, 0.08);
    border: 1px solid rgba(76, 201, 240, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .node-badge:hover {
    background: rgba(76, 201, 240, 0.2);
    box-shadow: 0 0 8px rgba(76, 201, 240, 0.3);
  }

  .vtuber-tags-table {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.5rem 0.8rem;
    border-radius: 4px;
    border: 1px solid rgba(224, 225, 221, 0.05);
  }

  .vt-spec-row {
    display: flex;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    gap: 8px;
  }

  .vt-label { font-weight: 700; color: var(--text-secondary); min-width: 120px; }
  .vt-val { font-weight: 600; color: var(--text-primary); }
  .text-dim { color: #8D99AE; }

  .vtuber-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vt-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(224, 225, 221, 0.15);
    padding: 0.3rem 0.7rem;
    border-radius: 3px;
    color: var(--text-primary);
    text-decoration: none;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .vt-link-btn:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: rgba(76, 201, 240, 0.1);
  }

  .btn-node {
    border-color: rgba(157, 78, 221, 0.4);
    color: var(--accent-purple);
  }
  .btn-node:hover {
    border-color: var(--accent-purple);
    color: #fff;
    background: rgba(157, 78, 221, 0.2);
  }

  .btn-dossier {
    border-color: rgba(76, 201, 240, 0.4);
    color: var(--accent-blue);
  }

  /* JOIN CARD */
  .join-network-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px dashed rgba(230, 57, 70, 0.4);
    background: rgba(11, 12, 16, 0.8);
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .join-tag {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-crimson);
    display: block;
    margin-bottom: 0.2rem;
  }

  .join-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.2rem;
    color: var(--text-primary);
    margin: 0 0 0.2rem 0;
    font-weight: 700;
  }

  .join-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  .btn { 
    display: inline-block; 
    padding: 0.65rem 1.3rem; 
    font-family: 'Rajdhani', sans-serif; 
    font-weight: 700; 
    text-decoration: none; 
    border-radius: 4px; 
    text-transform: uppercase; 
    cursor: pointer; 
    white-space: nowrap;
  }

  .btn-primary { background: var(--accent-crimson); color: white; border: none; }
  .btn-primary:hover { background: #ff4d5a; box-shadow: 0 0 12px rgba(230,57,70,0.4); }

  @media (max-width: 768px) {
    .page-title { font-size: 1.8rem; }
    .vtuber-layout { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .vt-spec-row { flex-direction: column; gap: 2px; }
    .vt-label { min-width: auto; }
    .vtuber-links { justify-content: center; }
    .join-network-card { flex-direction: column; align-items: flex-start; }
    .btn { width: 100%; text-align: center; }
  }
</style>