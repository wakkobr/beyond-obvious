---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Logo from '../components/Logo.astro';
import NavLogo from '../components/NavLogo.astro';
import TwitchStatus from '../components/TwitchStatus.astro';

type TerminalPost = CollectionEntry<'terminal'>;

interface ProcessedPost extends TerminalPost {
  slug: string;
  stars: string;
}

const posts = await getCollection('terminal');

const sortedPosts: ProcessedPost[] = posts
  .sort((a: TerminalPost, b: TerminalPost) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post: TerminalPost): ProcessedPost => ({
    ...post,
    slug: post.id.replace(/\.[^/.]+$/, ''),
    stars: '★'.repeat(parseInt(post.data.rating || '5', 10)),
  }));
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>BEYOND OBVIOUS // @W4KKO_</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Orbitron:wght@700;900&family=Rajdhani:wght@600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
</head>
<body>

  <nav class="nav-bar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <NavLogo />
      </a>
      <div class="nav-links">
        <a href="#stream" data-pt="Transmissões" data-en="Streams">Transmissões</a>
        <a href="/terminal" data-pt="Terminal" data-en="Terminal">Terminal</a>
        <a href="/about" data-pt="Sobre" data-en="About">Sobre</a>
        <a href="#signal" data-pt="Sinal" data-en="Signal">Sinal</a>
        <button id="lang-toggle" class="lang-btn">EN</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <section class="hero-split">
      <div class="hero-crest-frame">
        <div class="crest-corner top-left"></div>
        <div class="crest-corner top-right"></div>
        <div class="crest-corner bottom-left"></div>
        <div class="crest-corner bottom-right"></div>
        <Logo className="hero-crest-img" />
      </div>

      <div class="hero-info">
        <div class="status-badge" data-pt="◈ SISTEMA ONLINE // TRANSMISSÃO ATIVA" data-en="◈ SYSTEM ONLINE // ACTIVE TRANSMISSION">◈ SISTEMA ONLINE // TRANSMISSÃO ATIVA</div>
        <h1 class="hero-title">BEYOND OBVIOUS</h1>
        <p class="hero-sub">@w4kkomancer_ • <span data-pt="Tecnomago & Narrador" data-en="Technomancer & Storyteller">Tecnomago & Narrador</span></p>
        <p class="hero-bio" data-pt="Onde a lógica encontra o mistério e as narrativas vão além do óbvio. Análises de jogos, crônicas de RPG de mesa, desconstrução de ficção e transmissões ao vivo." data-en="Where logic meets mystery and narratives go beyond the obvious. Game reviews, tabletop RPG chronicles, sci-fi breakdowns, and live streams.">
          Onde a lógica encontra o mistério e as narrativas vão além do óbvio. Análises de jogos, crônicas de RPG de mesa, desconstrução de ficção e transmissões ao vivo.
        </p>
        <div class="hero-actions">
          <a href="#stream" class="btn btn-primary" data-pt="⚡ ACESSAR TRANSMISSÃO" data-en="⚡ ENTER STREAM">⚡ ACESSAR TRANSMISSÃO</a>
          <a href="/terminal" class="btn btn-outline" data-pt="📜 EXPLORAR TERMINAL" data-en="📜 EXPLORE TERMINAL">📜 EXPLORAR TERMINAL</a>
        </div>
      </div>
    </section>

    <section class="stream-status-section">
      <TwitchStatus channelName="w4kkomancer_" />
    </section>

    <section id="stream" class="section">
      <h2 class="section-title">01 // <span data-pt="TRANSMISSÕES AO VIVO" data-en="LIVE TRANSMISSIONS">TRANSMISSÕES AO VIVO</span></h2>
      <div class="hud-card">
        <p class="mb-4" data-pt="Aventuras narrativas, escolhas de peso e sessões de RPG de mesa ao vivo." data-en="Narrative-driven adventures, high-stakes choices, and live tabletop RPG sessions.">
          Aventuras narrativas, escolhas de peso e sessões de RPG de mesa ao vivo.
        </p>
        <div class="tags-grid">
          <span class="tag">🎮 Storytelling (Life is Strange, Tell Me Why)</span>
          <span class="tag" data-pt="🎲 Mesas de RPG & One-shots" data-en="🎲 Tabletop RPGs & One-shots">🎲 Mesas de RPG & One-shots</span>
          <span class="tag">⛏️ Sandbox & Minecraft</span>
          <span class="tag">💬 Just Chatting & Lore</span>
        </div>
      </div>
    </section>

    <section id="terminal" class="section">
      <div class="section-title-wrapper">
        <h2 class="section-title">02 // <span data-pt="TERMINAL DE MÍDIA" data-en="MEDIA TERMINAL">TERMINAL DE MÍDIA</span></h2>
        <a href="/terminal" class="view-all-link" data-pt="Ver Arquivo Geral &rarr;" data-en="View All Records &rarr;">Ver Arquivo Geral &rarr;</a>
      </div>

      <div class="posts-grid">
        {sortedPosts.length > 0 ? sortedPosts.map((post: ProcessedPost) => (
          <div class="hud-card">
            <div class="card-meta">
              <span class={`category-tag cat-${String(post.data.category || '').toLowerCase().trim()}`}>
                {String(post.data.category || '').toUpperCase()}
              </span>
              <span class="star-rating">
                {post.stars}
              </span>
            </div>
            <h3 class="card-title">{post.data.title}</h3>
            <p class="card-desc">
              {post.data.summary}
            </p>
            
            <div class="card-actions-terminal mt-3">
              <a href={`/terminal/${post.slug}`} class="btn-link" data-pt="Ler Registro Completo &rarr;" data-en="Read Full Log &rarr;">
                Ler Registro Completo &rarr;
              </a>
            </div>
          </div>
        )) : (
          <div class="hud-card">
            <p class="card-desc" data-pt="Nenhum registro encontrado no terminal." data-en="No records found in terminal.">Nenhum registro encontrado no terminal.</p>
          </div>
        )}
      </div>
    </section>

    <section id="signal" class="section">
      <h2 class="section-title">03 // <span data-pt="SINAL // PONTOS DE CONTATO" data-en="SIGNAL // CONTACT NODES">SIGNAL // PONTOS DE CONTATO</span></h2>
      <div class="hud-card">
        <p class="card-desc mb-4" data-pt="Conecte-se às frequências ativas da transmissão, servidores e documentações." data-en="Connect to active stream frequencies, community servers, and lore documentations.">
          Conecte-se às frequências ativas da transmissão, servidores e documentações.
        </p>
        <div class="signal-grid">
          <a href="https://twitch.tv/w4kkomancer_" target="_blank" rel="noopener noreferrer" class="signal-card">
            <span class="signal-icon">🟣</span>
            <div class="signal-info">
              <span class="signal-name">Twitch</span>
              <span class="signal-handle">@w4kkomancer_</span>
            </div>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="signal-card">
            <span class="signal-icon">🔴</span>
            <div class="signal-info">
              <span class="signal-name">YouTube</span>
              <span class="signal-handle" data-pt="VODs & Sessões" data-en="VODs & Sessions">VODs & Sessões</span>
            </div>
          </a>
          <a href="https://www.worldanvil.com/w/avian-wakkobr" target="_blank" rel="noopener noreferrer" class="signal-card">
            <span class="signal-icon">🗺️</span>
            <div class="signal-info">
              <span class="signal-name">World Anvil</span>
              <span class="signal-handle">Avian Wiki</span>
            </div>
          </a>
          <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="signal-card">
            <span class="signal-icon">💬</span>
            <div class="signal-info">
              <span class="signal-name">Discord</span>
              <span class="signal-handle" data-pt="Comunidade" data-en="Community">Comunidade</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© 2026 BEYOND OBVIOUS • @w4kkomancer_</p>
  </footer>

  <script>
    const toggleBtn = document.getElementById('lang-toggle');
    // Verifica se já existe um idioma salvo no localStorage (melhor UX!)
    let currentLang = localStorage.getItem('siteLang') || 'pt';

    // Função que aplica as traduções
    const applyLanguage = () => {
      if (toggleBtn) toggleBtn.textContent = currentLang === 'pt' ? 'EN' : 'PT';
      document.querySelectorAll('[data-pt]').forEach(el => {
        const target = el as HTMLElement;
        // Uso de innerHTML para não quebrar entidades HTML como &rarr; (setinha)
        target.innerHTML = currentLang === 'pt' ? target.dataset.pt! : target.dataset.en!;
      });
    };

    // Aplica no carregamento inicial
    if(currentLang === 'en') applyLanguage();

    // Evento de Clique
    toggleBtn?.addEventListener('click', () => {
      currentLang = currentLang === 'pt' ? 'en' : 'pt';
      localStorage.setItem('siteLang', currentLang);
      applyLanguage();
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg-canvas: #0B0C10;
    --bg-surface: #16181D;
    --accent-crimson: #E63946;
    --accent-blue: #4CC9F0;
    --accent-purple: #9D4EDD;
    --accent-pink: #F72585;
    --accent-gold: #F4A261;
    --accent-green: #2A9D8F;
    --text-primary: #E0E1DD;
    --text-secondary: #8D99AE;
  }

  body { margin: 0; background-color: var(--bg-canvas); color: var(--text-primary); font-family: 'Inter', sans-serif; line-height: 1.6; }
  .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
  .nav-bar { background: rgba(11, 12, 16, 0.95); border-bottom: 1px solid rgba(230, 57, 70, 0.2); position: sticky; top: 0; backdrop-filter: blur(10px); z-index: 100; height: 70px; display: flex; align-items: center; }
  .nav-container { width: 100%; max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; }
  .nav-brand { display: flex; align-items: center; text-decoration: none; }
  .nav-links { display: flex; gap: 1.4rem; align-items: center; }
  .nav-links a { color: var(--text-secondary); text-decoration: none; font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 600; transition: color 0.2s ease; }
  .nav-links a:hover { color: var(--accent-crimson); }
  .lang-btn { background: transparent; border: 1px solid var(--accent-blue); color: var(--accent-blue); padding: 0.2rem 0.6rem; border-radius: 4px; cursor: pointer; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.85rem; transition: all 0.2s ease; }
  .lang-btn:hover { background: rgba(76, 201, 240, 0.15); box-shadow: 0 0 8px rgba(76, 201, 240, 0.4); }
  .hero-split { display: grid; grid-template-columns: 240px 1fr; gap: 2.5rem; align-items: center; padding: 4rem 0 2.5rem; }
  .hero-crest-frame { position: relative; width: 220px; height: 220px; background: rgba(22, 24, 29, 0.6); border: 1px solid rgba(230, 57, 70, 0.3); display: flex; align-items: center; justify-content: center; padding: 1rem; box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6); }
  .hero-crest-img { max-width: 100%; max-height: 100%; }
  .crest-corner { position: absolute; width: 8px; height: 8px; border-color: var(--accent-crimson); }
  .crest-corner.top-left { top: -1px; left: -1px; border-top: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.top-right { top: -1px; right: -1px; border-top: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-left { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent-crimson); border-left: 2px solid var(--accent-crimson); }
  .crest-corner.bottom-right { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent-crimson); border-right: 2px solid var(--accent-crimson); }
  .hero-info { display: flex; flex-direction: column; align-items: flex-start; }
  .status-badge { display: inline-block; font-size: 0.75rem; color: var(--accent-blue); border: 1px solid rgba(76,201,240,0.3); padding: 0.3rem 0.8rem; border-radius: 20px; margin-bottom: 0.8rem; }
  .hero-title { font-family: 'Orbitron', sans-serif; font-size: 2.5rem; margin: 0; color: var(--text-primary); letter-spacing: 2px; line-height: 1.1; }
  .hero-sub { color: var(--accent-crimson); font-family: 'Rajdhani', sans-serif; font-size: 1.3rem; font-weight: 700; margin: 0.5rem 0 1rem; }
  .hero-bio { color: var(--text-secondary); margin: 0 0 1.5rem; font-size: 1rem; line-height: 1.6; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .stream-status-section { margin-bottom: 1.5rem; }
  .btn { display: inline-block; padding: 0.75rem 1.5rem; font-family: 'Rajdhani', sans-serif; font-weight: 700; text-decoration: none; border-radius: 4px; text-transform: uppercase; cursor: pointer; }
  .btn-primary { background: var(--accent-crimson); color: white; border: none; }
  .btn-primary:hover { background: #ff4d5a; box-shadow: 0 0 12px rgba(230,57,70,0.4); }
  .btn-outline { background: transparent; color: var(--text-primary); border: 1px solid rgba(224,225,221,0.2); }
  .btn-outline:hover { border-color: var(--accent-crimson); }
  .section { padding: 2.5rem 0 1rem; }
  .section-title-wrapper { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(224,225,221,0.1); padding-bottom: 0.5rem; margin-bottom: 1.5rem; }
  .section-title { font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; color: var(--accent-crimson); margin: 0; }
  .view-all-link { font-family: 'Rajdhani', sans-serif; font-weight: 700; color: var(--accent-blue); text-decoration: none; font-size: 0.95rem; transition: color 0.2s ease; }
  .view-all-link:hover { color: var(--accent-crimson); }
  .hud-card { background: var(--bg-surface); border: 1px solid rgba(224,225,221,0.1); border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .hud-card:hover { border-color: rgba(230,57,70,0.5); }
  .card-title { font-family: 'Rajdhani', sans-serif; font-size: 1.3rem; margin: 0 0 0.5rem; color: var(--text-primary); }
  .card-desc { color: var(--text-secondary); margin: 0; font-size: 0.95rem; }
  .card-meta { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.5rem; }
  .category-tag { font-weight: 700; }
  .cat-avian { color: #4CC9F0; }
  .cat-rpg { color: #9D4EDD; }
  .cat-gaming { color: #F72585; }
  .cat-narrativas { color: #F4A261; }
  .cat-nexus { color: #2A9D8F; }
  .star-rating { color: #F4A261; }
  .card-actions-terminal { display: flex; justify-content: flex-end; }
  .tags-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .tag { background: rgba(0,0,0,0.4); border: 1px solid rgba(224,225,221,0.1); font-size: 0.85rem; padding: 0.3rem 0.7rem; border-radius: 4px; }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .signal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
  .signal-card { display: flex; align-items: center; gap: 0.8rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(224,225,221,0.1); padding: 0.8rem 1rem; border-radius: 4px; text-decoration: none; color: var(--text-primary); transition: all 0.2s ease; }
  .signal-card:hover { border-color: var(--accent-crimson); transform: translateY(-2px); }
  .signal-icon { font-size: 1.2rem; }
  .signal-info { display: flex; flex-direction: column; }
  .signal-name { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.95rem; }
  .signal-handle { font-size: 0.75rem; color: var(--text-secondary); }
  .btn-link { color: var(--accent-blue); text-decoration: none; font-size: 0.9rem; display: inline-block; font-weight: 600; }
  .btn-link:hover { color: var(--accent-crimson); }
  .footer { text-align: center; padding: 3rem 0; color: var(--text-secondary); font-size: 0.85rem; border-top: 1px solid rgba(224,225,221,0.05); margin-top: 4rem; }
  .mt-3 { margin-top: 1rem; }
  .mb-4 { margin-bottom: 1.5rem; }
  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 0.8rem; padding: 0.8rem 1rem; }
    .nav-bar { height: auto; padding: 0.5rem 0; }
    .hero-split { grid-template-columns: 1fr; text-align: center; gap: 1.5rem; padding: 2rem 0; }
    .hero-crest-frame { margin: 0 auto; }
    .hero-info { align-items: center; }
    .hero-actions { justify-content: center; }
    .hero-title { font-size: 2rem; }
  }
</style>